{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://authz.xbac/schemas/gov/bo-schema-view.v2.schema.json",
  "title": "Governed BO schema_view v2",
  "description": "业务对象发布态完整元数据快照。用于运行时、API 生成、UI 生成和权限派生。",
  "type": "object",
  "required": ["boCode", "boName", "schemaVersion", "apiConfig", "boConfig", "entities"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "boCode": {
      "type": "string",
      "description": "BO 标识符，REST 资源路径第一段（复数小写 kebab-case）。",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "boName": {
      "type": "string",
      "description": "BO 中文名称。",
      "minLength": 1,
      "maxLength": 100
    },
    "description": { "type": "string", "maxLength": 500 },
    "schemaVersion": {
      "type": "string",
      "description": "schema 结构版本，不等同于业务发布版本。",
      "pattern": "^v?[0-9]+(\\.[0-9]+){0,2}$"
    },
    "apiConfig": { "$ref": "#/$defs/ApiConfig" },
    "boConfig": { "$ref": "#/$defs/BoConfig" },
    "listViewConfig": { "$ref": "#/$defs/ListViewConfig" },
    "entities": {
      "type": "array",
      "description": "实体树。应用层校验有且仅有一个 isPrimary=true 且 aggregateRole=ROOT。",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/Entity" }
    },
    "operations": {
      "type": "array",
      "description": "BO 完整操作清单。包含设计态显式声明的自定义操作 + 发布服务根据 apiConfig 自动补齐的标准 CRUD。自动补齐的操作标记 derived=true 并注明 derivedFrom。",
      "items": { "$ref": "#/$defs/Operation" },
      "default": []
    },
    "rules": {
      "type": "array",
      "description": "BO 业务规则清单。从 RULE fragment 投影，包含 COMPLEX_VALIDATION / STATE / DERIVATION / PERMISSION / AUTOMATION / CONSISTENCY 等规则类型。",
      "items": { "$ref": "#/$defs/Rule" },
      "default": []
    },
    "governance": { "$ref": "#/$defs/Governance" }
  },
  "$defs": {
    "ApiConfig": {
      "type": "object",
      "required": ["resourcePath", "idField", "idType", "responseWrapper", "batchResultType"],
      "additionalProperties": false,
      "properties": {
        "resourcePath": {
          "type": "string",
          "description": "聚合根 API 资源路径，固定为 /{boCode} 单段形式（如 /scenes）。子实体路由通过 entity.routeSegment 表达。",
          "pattern": "^/[a-z][a-z0-9-]*$"
        },
        "idField": {
          "type": "string",
          "description": "路径变量 {id} 对应主实体字段。",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "idType": { "type": "string", "enum": ["STRING", "LONG"] },
        "businessKeyField": {
          "type": "string",
          "description": "业务逻辑唯一键字段，如 scene_no、customer_no、biz_no。",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "responseWrapper": { "const": "ApiResponse" },
        "batchResultType": { "const": "BatchResultDTO" },
        "aggregateApiPolicy": { "$ref": "#/$defs/AggregateApiPolicy" },
        "searchEnabled": { "type": "boolean", "default": true },
        "batchEnabled": { "type": "boolean", "default": true }
      }
    },
    "AggregateApiPolicy": {
      "type": "object",
      "description": "聚合根标准 API 对聚合对象、主实体和子实体的处理范围声明。",
      "required": ["readScope", "createScope", "updateScope", "deleteScope"],
      "additionalProperties": false,
      "properties": {
        "listProjectionScope": {
          "type": "string",
          "description": "列表 API 返回范围。ROOT_SUMMARY 表示主实体字段加汇总/投影字段，不内嵌完整子实体。",
          "enum": ["ROOT_SUMMARY", "ROOT_ENTITY_ONLY", "FULL_AGGREGATE"],
          "default": "ROOT_SUMMARY"
        },
        "readScope": {
          "type": "string",
          "description": "详情 API GET /resources/{id} 的返回范围。",
          "enum": ["ROOT_ENTITY_ONLY", "FULL_AGGREGATE"],
          "default": "FULL_AGGREGATE"
        },
        "createScope": {
          "type": "string",
          "description": "创建 API POST /resources 的请求体处理范围。",
          "enum": ["ROOT_ENTITY_ONLY", "FULL_AGGREGATE"],
          "default": "FULL_AGGREGATE"
        },
        "updateScope": {
          "type": "string",
          "description": "普通更新 API PATCH /resources/{id} 的请求体处理范围。治理默认只更新主实体，避免误覆盖子实体。",
          "enum": ["ROOT_ENTITY_ONLY", "FULL_AGGREGATE_PATCH", "FULL_AGGREGATE_REPLACE"],
          "default": "ROOT_ENTITY_ONLY"
        },
        "deleteScope": {
          "type": "string",
          "description": "删除聚合根时对子实体的处理范围。",
          "enum": ["ROOT_ENTITY_ONLY", "CASCADE_AGGREGATE"],
          "default": "CASCADE_AGGREGATE"
        },
        "orphanPolicy": {
          "type": "string",
          "description": "deleteScope=ROOT_ENTITY_ONLY 时对子实体孤儿数据的治理策略。CASCADE_AGGREGATE 时通常不需要。",
          "enum": ["DENY_DELETE_WHEN_CHILD_EXISTS", "KEEP_CHILDREN_AS_HISTORY", "DETACH_CHILDREN", "MANUAL_CLEANUP_REQUIRED"],
          "default": "DENY_DELETE_WHEN_CHILD_EXISTS"
        },
        "detailEmbedEntities": {
          "type": "array",
          "description": "详情响应中内嵌的子实体列表。为空时由实体树自动推导全部非 DERIVED_VIEW 子实体。",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "uniqueItems": true,
          "default": []
        },
        "aggregateReplaceActionPath": {
          "type": "string",
          "description": "如需整棵聚合替换，必须使用显式操作路径，不复用普通 PATCH。",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "alternateAggregateApis": {
          "type": "array",
          "description": "当主实体接口和完整聚合接口需要并存时，声明额外端点，避免复用同一路径造成语义混淆。",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/AlternateAggregateApi" },
          "default": []
        }
      }
    },
    "AlternateAggregateApi": {
      "type": "object",
      "required": ["code", "method", "path", "requestScope", "responseScope"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "name": { "type": "string", "maxLength": 100 },
        "method": { "type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
        "path": { "type": "string", "pattern": "^/[a-z]([a-z0-9_/-]*|\\{[a-zA-Z0-9_]+\\}[a-z0-9_/-]*)*$" },
        "requestScope": { "type": "string", "enum": ["NONE", "KNOWN_IDS", "FILTER_DTO", "ROOT_ENTITY_ONLY", "FULL_AGGREGATE", "FULL_AGGREGATE_PATCH", "FULL_AGGREGATE_REPLACE"] },
        "responseScope": { "type": "string", "enum": ["VOID", "BATCH_RESULT", "ROOT_ENTITY_ONLY", "ROOT_SUMMARY", "FULL_AGGREGATE"] },
        "resultType": { "type": "string" },
        "description": { "type": "string", "maxLength": 500 }
      }
    },
    "BoConfig": {
      "type": "object",
      "required": ["objectType", "nameField"],
      "additionalProperties": false,
      "properties": {
        "objectType": { "type": "string", "enum": ["SINGLE", "TREE", "MASTER_DETAIL"], "default": "SINGLE" },
        "nameField": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "statusField": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "logicDeleteFlag": { "type": "boolean", "default": true },
        "versionFlag": { "type": "boolean", "default": false },
        "idStrategy": { "type": "string", "enum": ["AUTO_INCREMENT", "SNOWFLAKE"], "default": "SNOWFLAKE", "description": "ID 生成策略。SNOWFLAKE=应用层雪花算法（默认），AUTO_INCREMENT=DB 自增。" },
        "auditStrategy": { "type": "string", "enum": ["DATABASE", "APPLICATION"], "default": "DATABASE", "description": "审计时间戳维护方。DATABASE=DB DEFAULT CURRENT_TIMESTAMP，APPLICATION=应用层 MyBatis-Plus MetaObjectHandler（输出 DEFAULT NULL）。" },
        "defaultSort": { "$ref": "#/$defs/Sort" }
      }
    },
    "Sort": {
      "type": "object",
      "required": ["field"],
      "additionalProperties": false,
      "properties": {
        "field": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "direction": { "type": "string", "enum": ["asc", "desc"], "default": "desc" }
      }
    },
    "ListViewConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultPageSize": { "type": "integer", "enum": [10, 20, 50, 100], "default": 20 },
        "formLayout": { "type": "string", "enum": ["GRID", "VERTICAL", "HORIZONTAL"], "default": "GRID" },
        "formColumns": { "type": "integer", "enum": [1, 2, 3, 4], "default": 2 },
        "formLabelWidth": { "type": "integer", "minimum": 60, "maximum": 300, "default": 120 },
        "searchCollapsible": { "type": "boolean", "default": true }
      }
    },
    "Entity": {
      "type": "object",
      "required": ["code", "name", "isPrimary", "aggregateRole", "attributes"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "isPrimary": { "type": "boolean" },
        "aggregateRole": { "type": "string", "enum": ["ROOT", "SUB_ENTITY", "VALUE_OBJECT", "DERIVED_VIEW"] },
        "tableName": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "parentEntityCode": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "parentRefField": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "routeSegment": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "description": "REST 路由中的子路径片段。主实体（isPrimary=true）无需配置，直接使用 BO 的 resourcePath；子实体默认使用 entity.code 作为路由段，可手动修改为更语义化的路径（如 products、team-members）。" },
        "cascadeDelete": { "type": "boolean", "default": true },
        "readOnly": { "type": "boolean", "default": false },
        "entityNature": { "type": "string", "enum": ["BUSINESS", "ASSOCIATION"], "default": "BUSINESS", "description": "子实体性质：BUSINESS=承载独立业务数据（默认）；ASSOCIATION=纯关联联结表，仅含 PK+外键+CROSS_BO_DISPLAY 展示字段。仅 aggregateRole=SUB_ENTITY 时有效。" },
        "entityApiPolicy": { "$ref": "#/$defs/EntityApiPolicy" },
        "policyDerivedFields": {
          "type": "array",
          "description": "仅用于权限/数据策略配置的虚拟派生字段，由投影生成器展开为运行态 displayFieldMappings。",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/PolicyDerivedField" },
          "default": []
        },
        "attributes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/Attribute" } },
        "rowLevelRuleEntries": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }, "uniqueItems": true, "default": [] },
        "rowFallbackScope": { "type": "string", "enum": ["ALL", "NONE"], "default": "NONE" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "aggregateRole": { "const": "SUB_ENTITY" } },
            "required": ["aggregateRole"]
          },
          "then": { "required": ["parentEntityCode", "parentRefField"] }
        }
      ]
    },
    "PolicyDerivedField": {
      "type": "object",
      "required": ["code", "name", "type", "path", "target"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "type": { "type": "string", "enum": ["STRING", "INTEGER", "LONG", "DECIMAL", "BOOLEAN", "DATE", "DATETIME"] },
        "fieldName": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*$" },
        "labelPath": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 100 }, "default": [] },
        "path": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["hopKind", "fromEntityCode", "fromRefCode", "toEntityCode"],
            "additionalProperties": false,
            "properties": {
              "hopKind": { "type": "string", "enum": ["PARENT_REF"] },
              "fromEntityCode": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
              "fromRefCode": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
              "toEntityCode": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" }
            }
          }
        },
        "target": {
          "type": "object",
          "required": ["entityCode", "fieldCode"],
          "additionalProperties": false,
          "properties": {
            "entityCode": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
            "fieldCode": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
          }
        }
      }
    },
    "EntityApiPolicy": {
      "type": "object",
      "description": "子实体 API 对实体本体、下级子实体和局部聚合的处理范围声明。仅多级子实体或存在局部聚合接口需求时需要显式配置。",
      "required": ["readScope", "createScope", "updateScope", "deleteScope"],
      "additionalProperties": false,
      "properties": {
        "listProjectionScope": {
          "type": "string",
          "enum": ["ENTITY_SUMMARY", "ENTITY_ONLY", "ENTITY_AGGREGATE"],
          "default": "ENTITY_SUMMARY"
        },
        "readScope": {
          "type": "string",
          "enum": ["ENTITY_ONLY", "ENTITY_AGGREGATE"],
          "default": "ENTITY_ONLY"
        },
        "createScope": {
          "type": "string",
          "enum": ["ENTITY_ONLY", "ENTITY_AGGREGATE"],
          "default": "ENTITY_ONLY"
        },
        "updateScope": {
          "type": "string",
          "enum": ["ENTITY_ONLY", "ENTITY_AGGREGATE_PATCH", "ENTITY_AGGREGATE_REPLACE"],
          "default": "ENTITY_ONLY"
        },
        "deleteScope": {
          "type": "string",
          "enum": ["ENTITY_ONLY", "CASCADE_CHILDREN"],
          "default": "ENTITY_ONLY"
        },
        "orphanPolicy": {
          "type": "string",
          "enum": ["DENY_DELETE_WHEN_CHILD_EXISTS", "KEEP_CHILDREN_AS_HISTORY", "DETACH_CHILDREN", "MANUAL_CLEANUP_REQUIRED"],
          "default": "DENY_DELETE_WHEN_CHILD_EXISTS"
        },
        "detailEmbedEntities": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "uniqueItems": true,
          "default": []
        },
        "entityReplaceActionPath": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "alternateEntityApis": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/AlternateEntityApi" },
          "default": []
        }
      }
    },
    "AlternateEntityApi": {
      "type": "object",
      "required": ["code", "method", "path", "requestScope", "responseScope"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "name": { "type": "string", "maxLength": 100 },
        "method": { "type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
        "path": { "type": "string", "pattern": "^/[a-z]([a-z0-9_/-]*|\\{[a-zA-Z0-9_]+\\}[a-z0-9_/-]*)*$" },
        "requestScope": { "type": "string", "enum": ["NONE", "KNOWN_IDS", "FILTER_DTO", "ENTITY_ONLY", "ENTITY_AGGREGATE", "ENTITY_AGGREGATE_PATCH", "ENTITY_AGGREGATE_REPLACE"] },
        "responseScope": { "type": "string", "enum": ["VOID", "BATCH_RESULT", "ENTITY_ONLY", "ENTITY_SUMMARY", "ENTITY_AGGREGATE"] },
        "resultType": { "type": "string" },
        "description": { "type": "string", "maxLength": 500 }
      }
    },
    "Attribute": {
      "type": "object",
      "required": ["code", "name", "type"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "type": { "type": "string", "enum": ["STRING", "INTEGER", "LONG", "DECIMAL", "BOOLEAN", "DATE", "DATETIME"] },
        "isPk": { "type": "boolean", "default": false },
        "fieldName": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*$" },
        "columnName": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "semanticRole": { "type": "string", "enum": ["TECHNICAL_ID", "BUSINESS_KEY", "NAME", "STATUS", "PARENT_REF", "CROSS_BO_REF", "CROSS_BO_DISPLAY", "NORMAL"], "default": "NORMAL", "description": "CROSS_BO_REF 表示该字段是对另一个 BO 聚合根的 ID 引用，必须同时声明 crossBoRef。CROSS_BO_DISPLAY 表示该字段是从被引用 BO 冗余存储的展示字段（如名称、编码），须被某个 CROSS_BO_REF 属性的 crossBoRef.displayFields 引用。" },
        "crossBoRef": {
          "type": "object",
          "description": "semanticRole=CROSS_BO_REF 时必填。声明该字段指向的外部 BO 及关联字段。由设计态 MODEL fragment 直接投影到发布态，字段名保持一致。",
          "required": ["refBoCode", "refFieldCode"],
          "additionalProperties": false,
          "properties": {
            "refBoCode": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "description": "被引用 BO 的 boCode。" },
            "refEntityCode": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "description": "目标 BO 中被引用的实体 code。留空则默认使用目标 BO 的主实体（isPrimary=true 且 aggregateRole=ROOT）。仅当需引用目标 BO 的非主实体（如子实体）时才需显式指定。" },
            "refFieldCode": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "description": "目标 BO 主实体中被引用的字段，通常为 id 或 businessKey。" },
            "displayFields": {
              "type": "array",
              "description": "从被引用 BO 冗余展示的多字段配置。每项声明被引用 BO 的来源字段（refFieldCode）及本实体中已声明的伴生属性 code（localCode）。伴生属性须以 semanticRole=CROSS_BO_DISPLAY 声明。",
              "items": {
                "type": "object",
                "required": ["refFieldCode", "localCode"],
                "additionalProperties": false,
                "properties": {
                  "refFieldCode": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "description": "被引用 BO 主实体中的来源字段 code（如 name / code / description）。" },
                  "localCode": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "description": "本实体中对应的伴生属性 code，须已在同一 entity 的 attributes 中声明。" },
                  "displayRole": { "type": "string", "enum": ["NAME", "BUSINESS_KEY", "DESCRIPTION", "EXTRA"], "default": "EXTRA", "description": "伴生展示字段的语义角色：NAME=名称（最常用）；BUSINESS_KEY=业务编码；DESCRIPTION=描述（低频）；EXTRA=其他扩展字段。" }
                }
              },
              "default": []
            },
            "relationType": { "type": "string", "enum": ["MANY_TO_ONE", "ONE_TO_ONE"], "default": "MANY_TO_ONE", "description": "引用关系类型。" },
            "referenceNature": { "type": "string", "enum": ["MASTER_DATA", "BUSINESS_FLOW"], "default": "MASTER_DATA", "description": "引用性质：MASTER_DATA=主数据查找（如商机查找客户、用户）；BUSINESS_FLOW=上下游业务流关联（如场景生成商机）。" }
          }
        },
        "defaultValue": { "type": "string" },
        "filterable": { "type": "boolean", "default": false },
        "precision": { "type": "integer", "minimum": 1, "maximum": 38, "description": "仅 type=DECIMAL 时有效。数值总位数。默认 18。DDL 生成 DECIMAL(precision, scale)。" },
        "scale": { "type": "integer", "minimum": 0, "maximum": 30, "description": "仅 type=DECIMAL 时有效。小数位数。默认 2。DDL 生成 DECIMAL(precision, scale)。" },
        "redundant": { "type": "boolean", "default": false, "description": "仅 semanticRole=CROSS_BO_DISPLAY 时有效。true=在 DB/Entity 层也生成冗余列（性能优化）；false（默认）=仅在 View/DTO 层生成，DB 不留列，名称从权威源 JOIN 解析。" },
        "validation": { "$ref": "#/$defs/ValidationRule" },
        "semanticMapping": {
          "type": "object",
          "description": "枚举字段值到上层本体的语义映射，从设计态 VALIDATION fragment 投影。如 competition_level.STRONG → risk_level.HIGH，供推理引擎跨域求值使用。",
          "required": ["targetOntology", "map"],
          "additionalProperties": false,
          "properties": {
            "targetOntology": { "type": "string", "description": "映射目标本体的概念名" },
            "description": { "type": "string", "maxLength": 200 },
            "map": {
              "type": "object",
              "description": "源字段值 → 目标本体值的映射表",
              "minProperties": 1,
              "additionalProperties": { "type": "string" }
            }
          }
        },
        "fieldControl": { "type": "string", "enum": ["OPEN", "RESTRICTED", "MASKED", "HIDDEN"], "default": "OPEN" },
        "privacyClass": { "type": "string", "enum": ["PUBLIC", "SENSITIVE", "PII", "CONFIDENTIAL"], "default": "PUBLIC" },
        "reason": { "type": "string", "maxLength": 200, "description": "安全治理理由，从 SECURITY fragment 投影。" },
        "i18nKey": { "type": "string", "pattern": "^[a-z][a-z0-9._-]*$" },
        "translatable": { "type": "boolean", "default": false, "description": "非设计态 Fragment 投影字段，由发布服务根据项目配置注入。" },
        "translatableStrategy": { "type": "string", "enum": ["TL_TABLE", "JSON_COLUMN", "COLUMN_PER_LOCALE"], "description": "非设计态 Fragment 投影字段，由发布服务根据项目配置注入。" },
        "view": { "$ref": "#/$defs/ViewConfig" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "semanticRole": { "const": "CROSS_BO_REF" } },
            "required": ["semanticRole"]
          },
          "then": { "required": ["crossBoRef"] }
        },
        {
          "if": {
            "properties": { "type": { "enum": ["STRING", "INTEGER", "LONG", "BOOLEAN", "DATE", "DATETIME"] } }
          },
          "then": {
            "properties": {
              "precision": false,
              "scale": false
            }
          }
        }
      ]
    },
    "ValidationRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": { "type": "boolean", "default": false },
        "min": { "type": "number", "description": "STRING 类型字段解释为最小字符长度；INTEGER/LONG/DECIMAL 类型解释为最小数値。若同时配置 min 和 max，则 min 必须 ≤ max。" },
        "max": { "type": "number", "description": "STRING 类型字段解释为最大字符长度；INTEGER/LONG/DECIMAL 类型解释为最大数値。" },
        "pattern": { "type": "string" },
        "enum": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
        "message": { "type": "string", "maxLength": 300 },
        "unique": { "type": "boolean", "default": false }
      }
    },
    "ViewConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "displayName": { "type": "string" },
        "sortable": { "type": "boolean", "default": false },
        "columnWidth": { "type": "integer", "minimum": 40, "maximum": 1000 },
        "format": { "type": "string", "enum": ["currency", "date", "datetime", "percent", "text"] },
        "hidden": { "type": "boolean", "default": false, "description": "为 true 时优先级高于 showInList 和 showInDetail，两者均被视为 false（字段在列表和详情中均不显示）。" },
        "order": { "type": "integer", "minimum": 1 },
        "showInList": { "type": "boolean", "default": true },
        "showInDetail": { "type": "boolean", "default": true },
        "editableInForm": { "type": "boolean", "default": true, "description": "设计时静态声明：false 表示字段在表单中始终只读。与 disabled 区别：disabled 为运行时动态禁用；editableInForm=false 为静态设计决策。若 editableInForm=false，disabled 无意义。" },
        "instantValidate": { "type": "boolean", "default": false },
        "formType": { "type": "string", "enum": ["INPUT", "TEXTAREA", "NUMBER", "SELECT", "MULTI_SELECT", "DATE", "DATETIME", "SWITCH", "RADIO", "CHECKBOX", "USER_SELECT", "ORG_SELECT", "OBJECT_SELECT", "FILE_UPLOAD", "RICH_TEXT", "HIDDEN"] },
        "placeholder": { "type": "string" },
        "queryable": { "type": "boolean", "default": false },
        "queryOperatorOptions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["value", "label"],
            "additionalProperties": false,
            "properties": {
              "value": {
                "type": "string",
                "enum": ["EQ","NEQ","GT","GTE","LT","LTE","LIKE","NOT_LIKE","STARTS_WITH","ENDS_WITH","IN","NOT_IN","BETWEEN","IS_NULL","IS_NOT_NULL"]
              },
              "label": {
                "type": "string",
                "enum": ["等于","不等于","大于","大于等于","小于","小于等于","包含","不包含","开头是","结尾是","属于","不属于","区间","为空","不为空"]
              }
            }
          },
          "minItems": 1,
          "description": "仅在 queryable=true 时生效。数组首项为默认操作符，单项表示固定操作符。"
        },
        "dataType": {
          "type": "string",
          "enum": ["string", "integer", "decimal", "date", "datetime", "boolean", "enum", "reference"],
          "description": "字段存储的数据类型，独立于 formType。由设计态 VIEW fragment 直接投影。"
        },
        "exportable": { "type": "boolean", "default": true },
        "importable": { "type": "boolean", "default": false },
        "disabled": { "type": "boolean", "default": false, "description": "运行时默认禁用：true 表示字段渲染为只读状态。与 editableInForm 区别：editableInForm=false 为设计时静态决策；disabled 为运行时条件禁用。若 editableInForm=false，disabled 无意义。" },
        "dictCode": { "type": "string" },
        "refObject": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "description": "引用的目标 BO 的 boCode（kebab-case），由设计态 VIEW fragment 直接投影。" },
        "refField": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "formType": { "enum": ["SELECT", "MULTI_SELECT"] } },
            "required": ["formType"]
          },
          "then": { "required": ["dictCode"] }
        },
        {
          "if": {
            "properties": { "formType": { "const": "OBJECT_SELECT" } },
            "required": ["formType"]
          },
          "then": { "required": ["refObject"] }
        }
      ]
    },
    "Operation": {
      "type": "object",
      "required": ["code", "name", "scope", "operationKind", "primaryDataAction", "authzAction"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "scope": { "type": "string", "enum": ["BO", "ENTITY", "GLOBAL"] },
        "entityCode": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "operationKind": { "type": "string", "enum": ["CREATE", "UPDATE", "DELETE", "STATE_CHANGE", "IMPORT", "EXPORT", "MERGE", "CUSTOM"] },
        "primaryDataAction": {
          "type": "string",
          "enum": ["CREATE", "READ", "UPDATE", "DELETE"],
          "description": "该操作对业务数据层的主效应。用于权限归类、审计、读写路由、数据策略匹配和治理校验；复杂业务命令只填写其主效应。"
        },
        "authzAction": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "description": "发布到 PSP authz_permission_item.act_code 的授权动作，也是多个 Operation 归并到同一权限项的聚合键。必须显式配置，发布服务负责从设计态透传或根据 operationKind 推导并写入（CREATE→CREATE、UPDATE→UPDATE、DELETE→DELETE、MERGE→UPDATE、IMPORT→IMPORT、EXPORT→EXPORT）。STATE_CHANGE 和 CUSTOM 的 authzAction 在设计态即已确定。同一 BO 下相同 authzAction 只生成一条权限项，发布态可反向形成 permissionItem→operations 的派生关系；打开表单、保存表单等 UI 阶段不得单独生成 SAVE 权限项；提交审批、发布、归档、作废等独立业务命令应使用独立 authzAction。"
        },
        "httpMethod": { "type": "string", "enum": ["GET", "POST", "PATCH", "DELETE"], "default": "POST", "description": "操作触发的 HTTP 方法。PATCH 表达 REST 语义，Controller 实现层按治理规则降级为 POST + 动作路径。" },
        "actionPath": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "supportsBatch": { "type": "boolean", "default": false },
        "async": { "type": "boolean", "default": false },
        "singleResultType": { "type": "string" },
        "batchResultType": { "const": "BatchResultDTO", "description": "批量操作返回类型，固定为 BatchResultDTO。仅在 supportsBatch=true 时有意义；若 supportsBatch=false，发布服务应忽略本字段。" },
        "description": { "type": "string", "maxLength": 500 },
        "position": { "type": "string", "enum": ["TOOLBAR", "ROW", "DETAIL", "FLOATING"], "default": "ROW" },
        "triggerEvent": { "type": "string", "enum": ["OPEN_FORM", "API_CALL", "REDIRECT", "CONFIRM_THEN_API"], "default": "API_CALL", "description": "触发形态仅描述交互入口类别，不保存原型文件、按钮文案或事件函数引用。" },
        "derived": {
          "type": "boolean",
          "default": false,
          "description": "true 表示本操作为发布服务根据 apiConfig 自动补齐，非设计态 Fragment 显式声明。"
        },
        "derivedFrom": {
          "type": "string",
          "description": "派生来源说明，如 apiConfig.searchEnabled、apiConfig.readScope 等。仅在 derived=true 时有意义。",
          "maxLength": 200
        }
      },
      "allOf": [
        {
          "if": { "properties": { "scope": { "const": "ENTITY" } } },
          "then": { "required": ["entityCode"] }
        },
        {
          "if": {
            "properties": {
              "operationKind": { "const": "CUSTOM" },
              "triggerEvent": { "enum": ["API_CALL", "CONFIRM_THEN_API"] }
            },
            "required": ["operationKind", "triggerEvent"]
          },
          "then": { "required": ["actionPath"] }
        }
      ]
    },
    "Rule": {
      "type": "object",
      "description": "从 RULE fragment 投影的业务规则。",
      "required": ["code", "name", "ruleType"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "ruleType": {
          "type": "string",
          "enum": ["COMPLEX_VALIDATION", "STATE", "DERIVATION", "PERMISSION", "AUTOMATION", "CONSISTENCY"]
        },
        "scope": { "type": "string", "enum": ["BO", "ENTITY", "FIELD", "OPERATION", "CROSS_BO"], "default": "BO" },
        "entityCode": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "fieldCode": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "operationCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "crossBoRef": {
          "type": "object",
          "description": "scope=CROSS_BO 时必填。声明本 BO 字段对目标 BO 的跨聚合约束。",
          "required": ["refBoCode", "refFieldCode", "localEntityCode", "localFieldCode"],
          "additionalProperties": false,
          "properties": {
            "refBoCode": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
            "refEntityCode": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
            "refFieldCode": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
            "localEntityCode": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
            "localFieldCode": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
          }
        },
        "trigger": {
          "type": "string",
          "enum": ["BEFORE_VALIDATE", "BEFORE_OPERATION", "AFTER_OPERATION", "ON_STATE_CHANGE", "ON_PUBLISH", "ON_READ"],
          "default": "BEFORE_OPERATION"
        },
        "expression": { "type": "string", "maxLength": 2000 },
        "polarity": {
          "type": "string",
          "enum": ["violation", "safety"],
          "default": "violation",
          "description": "expression 的语义极性。violation（默认）：表达式为 True 表示违规；safety：表达式为 True 表示安全/合规。从设计态 RULE fragment 投影。"
        },
        "action": { "type": "string", "maxLength": 500 },
        "severity": { "type": "string", "enum": ["INFO", "WARN", "ERROR"], "default": "ERROR" },
        "message": { "type": "string", "maxLength": 300 },
        "description": { "type": "string", "maxLength": 500 }
      },
      "allOf": [
        {
          "if": { "properties": { "scope": { "const": "CROSS_BO" } }, "required": ["scope"] },
          "then": { "required": ["crossBoRef"] }
        },
        {
          "if": { "properties": { "scope": { "const": "ENTITY" } }, "required": ["scope"] },
          "then": { "required": ["entityCode"] }
        },
        {
          "if": { "properties": { "scope": { "const": "FIELD" } }, "required": ["scope"] },
          "then": { "required": ["entityCode", "fieldCode"] }
        },
        {
          "if": { "properties": { "scope": { "const": "OPERATION" } }, "required": ["scope"] },
          "then": { "required": ["operationCode"] }
        }
      ]
    },
    "Governance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceFragmentVersion": { "type": "integer" },
        "releaseVersion": { "type": "integer" },
        "checksum": { "type": "string" },
        "generatedAt": { "type": "string" },
        "generatedBy": { "type": "string" }
      }
    }
  }
}
