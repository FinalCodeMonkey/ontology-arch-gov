{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://authz.xbac/schemas/gov/fragments/security-fragment.schema.v3.json",
  "title": "BO SECURITY fragment",
  "description": "BO 安全治理 Fragment。用于补充 PSP authz_bo_meta_model 中某一条业务对象元数据的安全投影，生成 DATA 行级策略候选字段、FIELD 字段控制候选字段和 res.* 资源属性契约；它不是角色授权记录本身。",
  "$comment": "约束清单详见父目录下的 CONSTRAINTS.md 中 [SECURITY Fragment] 章节。",
  "type": "object",
  "required": ["rowSecurity", "fieldSecurity"],
  "additionalProperties": false,
  "properties": {
    "rowSecurity": {
      "type": "object",
      "description": "行级安全配置。entriesByEntity 声明哪些实体字段允许进入 PSP DATA 策略和 SQL 行过滤；fallbackScope 声明无数据策略命中时的默认范围建议。",
      "required": ["entriesByEntity"],
      "additionalProperties": false,
      "properties": {
        "fallbackScope": { "type": "string", "enum": ["ALL", "NONE"], "default": "NONE" },
        "entriesByEntity": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
            "uniqueItems": true
          }
        }
      }
    },
    "fieldSecurity": {
      "type": "array",
      "uniqueItems": true,
      "$comment": "uniqueItems 做浅层去重；(entityCode, fieldCode) 级唯一性由 check_consistency.py 保障",
      "description": "字段级安全配置。发布到 PSP 时应转换为 BO schema 属性上的 fieldControl=true 和 fieldControlStrategy；治理值 MASKED/HIDDEN 需映射为 PSP FIELD action 的 MASK/HIDE。必填但可为空数组——空数组表示已审慎确认此 BO 无敏感字段，区别于遗漏配置。",
      "items": {
        "type": "object",
        "required": ["entityCode", "fieldCode", "fieldControl", "privacyClass"],
        "additionalProperties": false,
        "properties": {
          "entityCode": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "fieldCode": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "description": "待保护的字段 code。注意：不应选择 semanticRole 为 CROSS_BO_REF、TECHNICAL_ID、PARENT_REF、BUSINESS_KEY 的字段——外键/技术键本身不包含敏感业务内容；行级安全通过 rowSecurity 控制，名称脱敏应在目标被引用 BO 的 SECURITY 中处理。check_consistency.py 会对此做跨 Fragment 强制校验。" },
          "fieldControl": { "type": "string", "enum": ["OPEN", "RESTRICTED", "MASKED", "HIDDEN"] },
          "privacyClass": { "type": "string", "enum": ["PUBLIC", "SENSITIVE", "PII", "CONFIDENTIAL"] },
          "reason": { "type": "string", "maxLength": 200 }
        }
      },
      "default": []
    },
    "authzProjection": {
      "type": "object",
      "description": "从 BO 发布态派生并嵌入 authz_bo_meta_model.schema_json 的资源属性投影。直接使用 boCode 作为投影编码，无需在设计态手动维护。",
      "required": ["attributes"],
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string", "maxLength": 500 },
        "usageNote": { "type": "string", "maxLength": 1000 },
        "attributes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": ["code", "name", "type", "source"],
            "additionalProperties": false,
            "properties": {
              "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
              "name": { "type": "string" },
              "type": { "type": "string", "enum": ["STRING", "INTEGER", "LONG", "DECIMAL", "BOOLEAN", "DATE", "DATETIME"] },
              "source": {
                "type": "object",
                "required": ["entityCode", "fieldCode"],
                "additionalProperties": false,
                "properties": {
                  "entityCode": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
                  "fieldCode": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
                  "computed": { "type": "boolean", "default": false },
                  "derivationHint": { "type": "string" }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": { "computed": { "const": true } },
                      "required": ["computed"]
                    },
                    "then": { "required": ["derivationHint"] }
                  }
                ]
              },
              "isPk": { "type": "boolean", "default": false },
              "filterable": { "type": "boolean", "default": false },
              "nullable": { "type": "boolean", "default": true },
              "onMissingValue": { "type": "string", "enum": ["DENY", "ALLOW", "SKIP"], "default": "DENY" },
              "allowedValues": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["value", "label"],
                  "additionalProperties": false,
                  "properties": {
                    "value": { "type": "string", "minLength": 1, "maxLength": 64, "description": "存储值/编码，用于数据持久化和策略表达式" },
                    "label": { "type": "string", "minLength": 1, "maxLength": 100, "description": "显示名，用于界面呈现" }
                  }
                },
                "minItems": 1,
                "uniqueItems": true,
                "description": "允许值列表。每条为 {value, label} 对，value 用于策略表达式和 PIP 返回，label 用于 UI 展示。"
              },
              "valueRef": { "type": "string" },
              "referenceModel": { "type": "string" },
              "displayOrder": { "type": "integer" },
              "displayGroup": { "type": "string" },
              "description": { "type": "string" },
              "i18nKey": { "type": "string" },
              "valueExamples": { "type": "array", "items": { "type": "string" } }
            },
            "allOf": [
              {
                "not": {
                  "required": ["allowedValues", "valueRef"]
                }
              }
            ]
          }
        }
      }
    }
  }
}
