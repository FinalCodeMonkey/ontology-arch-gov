{
  "$schema": "https://authz.xbac/schemas/gov/bo-meta-fragment.schema.json",
  "tenantId": "cbg",
  "appCode": "crm",
  "boCode": "devices",
  "metaType": "OPERATION",
  "draftVersion": "1.0",
  "schemaVersion": "2.0",
  "content": {
    "operations": [
      {
        "code": "QUERY",
        "name": "查询设备档案",
        "scope": "BO",
        "operationKind": "CUSTOM",
        "primaryDataAction": "READ",
        "authzAction": "LIST",
        "httpMethod": "POST",
        "actionPath": "query",
        "supportsBatch": false,
        "singleResultType": "ApiResponse<PageResult<DeviceListItemVO>>",
        "position": "TOOLBAR",
        "triggerEvent": "API_CALL",
        "description": "分页查询设备档案列表，支持按客户名称关键词搜索、列头筛选、排序。数据来源为外部 DPR 系统聚合 + 本地状态覆盖。API：POST /devices/query。"
      },
      {
        "code": "STATS",
        "name": "查询设备统计",
        "scope": "BO",
        "operationKind": "CUSTOM",
        "primaryDataAction": "READ",
        "authzAction": "READ",
        "httpMethod": "POST",
        "actionPath": "stats",
        "supportsBatch": false,
        "singleResultType": "ApiResponse<DeviceArchiveStatsVO>",
        "position": "TOOLBAR",
        "triggerEvent": "API_CALL",
        "description": "查询设备档案统计卡片数据（设备总量、运行中、近半年过保、近一年过保、过保设备）。API：POST /devices/stats。"
      },
      {
        "code": "GET_DETAIL",
        "name": "查询设备详情",
        "scope": "BO",
        "operationKind": "CUSTOM",
        "primaryDataAction": "READ",
        "authzAction": "READ",
        "httpMethod": "GET",
        "supportsBatch": false,
        "singleResultType": "ApiResponse<DeviceDetailVO>",
        "position": "ROW",
        "triggerEvent": "API_CALL",
        "description": "按设备序列号查询设备档案详情。API：GET /devices/getDetail/{deviceSerialNo}。",
        "actionPath": "detail"
      },
      {
        "code": "EXPORT",
        "name": "导出设备档案",
        "scope": "GLOBAL",
        "operationKind": "EXPORT",
        "primaryDataAction": "READ",
        "authzAction": "EXPORT",
        "httpMethod": "POST",
        "actionPath": "export",
        "async": false,
        "singleResultType": "Void",
        "position": "TOOLBAR",
        "triggerEvent": "API_CALL",
        "description": "导出选中设备的档案数据为 Excel。仅支持勾选设备后导出。API：POST /devices/export。"
      },
      {
        "code": "UPDATE_STATUS",
        "name": "更新设备状态",
        "scope": "BO",
        "operationKind": "STATE_CHANGE",
        "primaryDataAction": "UPDATE",
        "authzAction": "UPDATE_STATUS",
        "httpMethod": "POST",
        "actionPath": "update-status",
        "supportsBatch": false,
        "singleResultType": "ApiResponse<DeviceDetailVO>",
        "position": "ROW",
        "triggerEvent": "API_CALL",
        "description": "更新设备本地维护状态（device_status）。仅落本地覆盖层 crm_device_local_state，不反向改写外部设备主档。API：POST /devices/{deviceSerialNo}/actions/update-status。"
      },
      {
        "code": "UPLOAD_INVENTORY",
        "name": "上传盘点附件",
        "scope": "GLOBAL",
        "operationKind": "IMPORT",
        "primaryDataAction": "CREATE",
        "authzAction": "INVENTORY",
        "httpMethod": "POST",
        "actionPath": "upload-inventory",
        "async": false,
        "position": "TOOLBAR",
        "triggerEvent": "OPEN_FORM",
        "description": "上传盘点附件（Excel），自动匹配设备序列号，快速批量导入设备信息进行盘点。触发 EquipArchiveUploadDrawer 抽屉组件。"
      },
      {
        "code": "MANUAL_INVENTORY",
        "name": "设备盘点",
        "scope": "GLOBAL",
        "operationKind": "CUSTOM",
        "primaryDataAction": "UPDATE",
        "authzAction": "INVENTORY",
        "httpMethod": "POST",
        "actionPath": "manual-inventory",
        "async": false,
        "position": "TOOLBAR",
        "triggerEvent": "API_CALL",
        "description": "选中设备进行对比盘点。需先勾选设备，触发 EquipArchiveManualInventoryDrawer 抽屉组件，以设备序列号为种子创建手工盘点会话。"
      }
    ]
  }
}
