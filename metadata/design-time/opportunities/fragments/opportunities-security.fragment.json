        {
          "code": "opportunity_id",
          "name": "商机ID",
          "type": "LONG",
          "source": {
            "entityCode": "opportunity",
            "fieldCode": "id"
          },
          "isPk": true,
          "filterable": false,
          "nullable": false,
          "onMissingValue": "DENY",
          "displayOrder": 10,
          "displayGroup": "基本标识",
          "description": "商机资源唯一标识，供 PIP 按 ID 拉取完整属性集合。",
          "i18nKey": "auth.resource.res_opportunity.attr.opportunity_id",
          "valueExamples": [
            "10001",
            "10002"
          ]
        },
        {
          "code": "opportunity_name",
          "name": "业务机会名称",
