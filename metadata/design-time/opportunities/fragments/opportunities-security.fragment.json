      "fallbackScope": "NONE",
      "entriesByEntity": {
        "opportunity": [
          "tenant_code",
          "status",
          "project_type",
          "biz_attribution",
          "domestic_overseas",
          "predict_category",
          "project_stage",
          "opportunity_owner",
          "customer_owner",
          "customers_id",
          "market_segment",
          "parent_opportunity_id"
        ]
      }
    },
    "fieldSecurity": [
      {
        "entityCode": "opportunity",
        "fieldCode": "expected_order_amount",
        "fieldControl": "MASKED",
        "privacyClass": "SENSITIVE",
        "reason": "预计下单金额/集采框架总金额为敏感商业数据，默认脱敏显示"
      },
      {
        "entityCode": "opportunity-product",
        "fieldCode": "unit_price",
        "fieldControl": "MASKED",
        "privacyClass": "SENSITIVE",
        "reason": "出货单价为敏感价格数据，默认脱敏"
      },
      {
        "entityCode": "opportunity",
        "fieldCode": "is_in_funnel",
        "fieldControl": "RESTRICTED",
        "privacyClass": "CONFIDENTIAL",
        "reason": "是否进入漏斗为销售预测核心指标，仅销售预测角色可编辑，其他角色只读"
      },
      {
        "entityCode": "opportunity",
        "fieldCode": "is_committed",
        "fieldControl": "RESTRICTED",
        "privacyClass": "CONFIDENTIAL",
        "reason": "是否承诺为销售预测核心指标，仅销售预测角色可编辑，其他角色只读"
      }
    ],
    "authzProjection": {
      "description": "商机业务对象在 PSP 中的资源属性投影。运行时权限项通过 RES_DATA_BO + authz-bo-meta-model.id + act_code 定位 opportunities BO，投影编码由发布服务根据 boCode 自动派生。",
      "usageNote": "用于数据权限、列表行级过滤和敏感字段访问控制。rowSecurity 声明 DATA 策略候选字段，fieldSecurity 声明 FIELD 策略候选字段。策略表达式中典型引用方式包括 res.tenant_code、res.status、res.project_type、res.biz_attribution、res.domestic_overseas、res.predict_category、res.project_stage、res.opportunity_owner 等。字段控制发布到 PSP 时需将 MASKED/HIDDEN 转换为 MASK/HIDE。",
