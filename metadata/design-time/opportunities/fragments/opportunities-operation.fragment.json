{
  "$schema": "https://authz.xbac/schemas/gov/bo-meta-fragment.schema.json",
  "tenantId": "cbg",
  "appCode": "crm",
  "boCode": "opportunities",
  "metaType": "OPERATION",
  "draftVersion": "1.0",
  "schemaVersion": "2.0",
  "content": {
    "operations": [
      {
        "code": "CREATE",
        "name": "新增业务机会",
        "scope": "BO",
        "operationKind": "CREATE",
        "primaryDataAction": "CREATE",
        "authzAction": "CREATE",
        "httpMethod": "POST",
        "supportsBatch": true,
        "singleResultType": "ApiResponse<OpportunityDTO>",
        "batchResultType": "BatchResultDTO",
        "position": "TOOLBAR",
        "triggerEvent": "OPEN_FORM",
        "description": "新建商机，分两步向导：第一步录入基本信息与归属人员，第二步录入产品清单。标准 API：POST /opportunities。"
      },
      {
        "code": "IMPORT",
        "name": "导入",
        "scope": "GLOBAL",
        "operationKind": "IMPORT",
        "primaryDataAction": "CREATE",
        "authzAction": "IMPORT",
        "httpMethod": "POST",
        "actionPath": "import",
        "async": false,
        "singleResultType": "ApiResponse<OpportunityImportResultDTO>",
        "position": "TOOLBAR",
        "triggerEvent": "OPEN_FORM",
        "description": "批量导入商机数据，含必填和枚举校验，导入后自动查重。API：POST /opportunities/import。"
      },
      {
        "code": "EXPORT",
        "name": "导出",
        "scope": "GLOBAL",
        "operationKind": "EXPORT",
        "primaryDataAction": "READ",
        "authzAction": "EXPORT",
        "httpMethod": "POST",
        "actionPath": "export",
        "async": true,
        "singleResultType": "ApiResponse<ExportTaskDTO>",
        "position": "TOOLBAR",
        "triggerEvent": "API_CALL",
        "description": "导出商机列表数据，金额字段按权限脱敏。API：POST /opportunities/export。"
      },
      {
        "code": "COPY",
        "name": "复制商机",
        "scope": "BO",
        "operationKind": "CREATE",
        "primaryDataAction": "CREATE",
        "authzAction": "CREATE",
        "httpMethod": "POST",
        "actionPath": "copy",
        "supportsBatch": false,
        "singleResultType": "ApiResponse<OpportunityDTO>",
        "position": "DETAIL",
        "triggerEvent": "OPEN_FORM",
        "description": "复制当前商机数据进入新建页面，业务机会名称自动追加「-复制」。API：POST /opportunities/{id}/copy。"
      },
      {
        "code": "EDIT",
        "name": "编辑商机",
        "scope": "BO",
        "operationKind": "UPDATE",
        "primaryDataAction": "UPDATE",
        "authzAction": "UPDATE",
        "httpMethod": "PATCH",
        "supportsBatch": true,
        "singleResultType": "ApiResponse<OpportunityDTO>",
        "batchResultType": "BatchResultDTO",
        "position": "DETAIL",
        "triggerEvent": "OPEN_FORM",
        "description": "编辑商机基本信息与人员。项目类型创建后不可修改，禁止修改 is_in_funnel 和 is_committed（走 UPDATE_SALES_FORECAST）。标准 API：PATCH /opportunities/{id}。"
      },
      {
        "code": "DELETE",
        "name": "删除商机",
        "scope": "BO",
        "operationKind": "DELETE",
        "primaryDataAction": "DELETE",
        "authzAction": "DELETE",
        "httpMethod": "DELETE",
        "supportsBatch": true,
        "singleResultType": "Void",
        "batchResultType": "BatchResultDTO",
        "position": "DETAIL",
        "triggerEvent": "CONFIRM_THEN_API",
        "description": "逻辑删除商机（含级联删除子实体：产品清单、团队成员、场景关联、阶段历史、报价单引用）。仅草稿态商机可删除，已跟进（ACTIVE）和已结束（终态）商机不可删除。API：DELETE /opportunities/{id}。"
      },
      {
        "code": "CREATE_QUOTATION",
        "name": "创建报价单",
        "scope": "BO",
        "operationKind": "CUSTOM",
        "primaryDataAction": "CREATE",
        "authzAction": "CREATE_QUOTATION",
        "httpMethod": "POST",
        "actionPath": "create-quotation",
        "supportsBatch": false,
        "singleResultType": "ApiResponse<QuotationDTO>",
        "position": "DETAIL",
        "triggerEvent": "REDIRECT",
        "description": "跳转至 ECP 系统创建报价单，自动将产品清单带入 ECP。按项目类型限制可选报价类型。API：POST /opportunities/{id}/create-quotation。"
      },
      {
        "code": "APPLY_PROJECT_MATERIALS",
        "name": "项目资料申请",
        "scope": "BO",
        "operationKind": "CUSTOM",
        "primaryDataAction": "CREATE",
        "authzAction": "APPLY_PROJECT_MATERIALS",
        "httpMethod": "POST",
        "actionPath": "apply-materials",
        "supportsBatch": false,
        "singleResultType": "ApiResponse<ProjectMaterialsResultDTO>",
        "position": "DETAIL",
        "triggerEvent": "OPEN_FORM",
        "description": "向相关部门申请项目资料（如技术方案、测试报告、资质文件等），支持选择资料类型和填写申请说明。API：POST /opportunities/{id}/apply-materials。"
      },
      {
        "code": "ADVANCE_STAGE",
        "name": "推进销售阶段",
        "scope": "BO",
        "operationKind": "STATE_CHANGE",
        "primaryDataAction": "UPDATE",
        "authzAction": "ADVANCE_STAGE",
        "httpMethod": "POST",
        "actionPath": "advance-stage",
        "supportsBatch": false,
        "singleResultType": "ApiResponse<OpportunityDTO>",
        "position": "DETAIL",
        "triggerEvent": "OPEN_FORM",
        "description": "手动推进销售流程至指定阶段，支持跨阶段推进，推进说明非必填。API：POST /opportunities/{id}/advance-stage。"
      },
      {
        "code": "ROLLBACK_STAGE",
        "name": "退回上一阶段",
        "scope": "BO",
        "operationKind": "STATE_CHANGE",
        "primaryDataAction": "UPDATE",
        "authzAction": "ROLLBACK_STAGE",
        "httpMethod": "POST",
        "actionPath": "rollback-stage",
        "supportsBatch": false,
        "singleResultType": "ApiResponse<OpportunityDTO>",
        "position": "DETAIL",
        "triggerEvent": "CONFIRM_THEN_API",
        "description": "将销售流程退回到上一阶段，历史推进记录保留。API：POST /opportunities/{id}/rollback-stage。"
      },
      {
        "code": "START_PROGRESS",
        "name": "开始跟进",
        "scope": "BO",
        "operationKind": "STATE_CHANGE",
        "primaryDataAction": "UPDATE",
        "authzAction": "START_PROGRESS",
        "httpMethod": "POST",
        "actionPath": "start-progress",
        "supportsBatch": false,
        "singleResultType": "ApiResponse<OpportunityDTO>",
        "position": "DETAIL",
        "triggerEvent": "CONFIRM_THEN_API",
        "description": "将草稿态商机激活为跟进中状态（DRAFT → ACTIVE），触发销售流程第一阶段。无审批环节，销售人员创建商机后直接开始跟进。API：POST /opportunities/{id}/start-progress。"
      },
      {
        "code": "WIN",
        "name": "赢单",
        "scope": "BO",
        "operationKind": "STATE_CHANGE",
        "primaryDataAction": "UPDATE",
        "authzAction": "WIN",
        "httpMethod": "POST",
        "actionPath": "win",
        "supportsBatch": false,
        "singleResultType": "ApiResponse<OpportunityDTO>",
        "position": "DETAIL",
        "triggerEvent": "CONFIRM_THEN_API",
        "description": "商机成功签约，商机进入「已赢单」终态。仅 ACTIVE 状态可赢单，结束后允许重启。API：POST /opportunities/{id}/win。"
      },
      {
        "code": "LOSE",
        "name": "输单",
        "scope": "BO",
        "operationKind": "STATE_CHANGE",
        "primaryDataAction": "UPDATE",
        "authzAction": "LOSE",
        "httpMethod": "POST",
        "actionPath": "lose",
        "supportsBatch": false,
        "singleResultType": "ApiResponse<OpportunityDTO>",
        "position": "DETAIL",
        "triggerEvent": "CONFIRM_THEN_API",
        "description": "商机竞争失败，商机进入「已输单」终态。仅 ACTIVE 状态可输单，结束后允许重启。API：POST /opportunities/{id}/lose。"
      },
      {
        "code": "CANCEL",
        "name": "取消商机",
        "scope": "BO",
        "operationKind": "STATE_CHANGE",
        "primaryDataAction": "UPDATE",
        "authzAction": "CANCEL",
        "httpMethod": "POST",
        "actionPath": "cancel",
        "supportsBatch": false,
        "singleResultType": "ApiResponse<OpportunityDTO>",
        "position": "DETAIL",
        "triggerEvent": "CONFIRM_THEN_API",
        "description": "因客户取消项目、预算撤回等原因终止，商机进入「已取消」终态。DRAFT/ACTIVE 可取消，已终态不重复取消。API：POST /opportunities/{id}/cancel。"
      },
      {
        "code": "RESTART",
        "name": "重启商机",
        "scope": "BO",
        "operationKind": "STATE_CHANGE",
        "primaryDataAction": "UPDATE",
        "authzAction": "RESTART",
        "httpMethod": "POST",
        "actionPath": "restart",
        "supportsBatch": false,
        "singleResultType": "ApiResponse<OpportunityDTO>",
        "position": "DETAIL",
        "triggerEvent": "CONFIRM_THEN_API",
        "description": "重新启动已终态（赢单/输单/取消）的商机，销售流程从第一阶段重新开始，历史记录保留。API：POST /opportunities/{id}/restart。"
      },
      {
        "code": "FINISH",
        "name": "结束销售流程",
        "scope": "BO",
        "operationKind": "STATE_CHANGE",
        "primaryDataAction": "UPDATE",
        "authzAction": "FINISH",
        "httpMethod": "POST",
        "actionPath": "finish",
        "supportsBatch": false,
        "singleResultType": "Void",
        "position": "DETAIL",
        "triggerEvent": "CONFIRM_THEN_API",
        "description": "结束当前销售流程，根据 finishType 决定终止还是完成。API：POST /opportunities/{id}/finish。"
      },
      {
        "code": "CREATE_PRODUCT",
        "name": "新建产品清单",
        "scope": "ENTITY",
        "entityCode": "opportunity-product",
        "operationKind": "CREATE",
        "primaryDataAction": "CREATE",
        "authzAction": "CREATE_PRODUCT",
        "httpMethod": "POST",
        "supportsBatch": false,
        "singleResultType": "ApiResponse<OpportunityProductDTO>",
        "position": "DETAIL",
        "triggerEvent": "OPEN_FORM",
        "description": "在商机下新增产品清单行。API：POST /opportunities/{id}/opportunity-product。"
      },
      {
        "code": "EDIT_PRODUCT",
        "name": "编辑产品清单",
        "scope": "ENTITY",
        "entityCode": "opportunity-product",
        "operationKind": "UPDATE",
        "primaryDataAction": "UPDATE",
        "authzAction": "EDIT_PRODUCT",
        "httpMethod": "PATCH",
        "supportsBatch": false,
        "singleResultType": "ApiResponse<OpportunityProductDTO>",
        "position": "ROW",
        "triggerEvent": "OPEN_FORM",
        "description": "编辑产品型号、出货单价和数量。API：PATCH /opportunities/{id}/opportunity-product/{subId}。"
      },
      {
        "code": "DELETE_PRODUCT",
        "name": "删除产品清单",
        "scope": "ENTITY",
        "entityCode": "opportunity-product",
        "operationKind": "DELETE",
        "primaryDataAction": "DELETE",
        "authzAction": "DELETE_PRODUCT",
        "httpMethod": "DELETE",
        "supportsBatch": true,
        "singleResultType": "Void",
        "batchResultType": "BatchResultDTO",
        "position": "ROW",
        "triggerEvent": "CONFIRM_THEN_API",
        "description": "删除产品清单行。API：DELETE /opportunities/{id}/opportunity-product/{subId}。"
      },
      {
        "code": "CREATE_TEAM_MEMBER",
        "name": "新增团队成员",
        "scope": "ENTITY",
        "entityCode": "opportunity-team-member",
        "operationKind": "CREATE",
        "primaryDataAction": "CREATE",
        "authzAction": "CREATE_TEAM_MEMBER",
        "httpMethod": "POST",
        "supportsBatch": false,
        "singleResultType": "ApiResponse<OpportunityTeamMemberDTO>",
        "position": "DETAIL",
        "triggerEvent": "OPEN_FORM",
        "description": "新增商机团队成员，含成员姓名、角色、权限设置和备注。API：POST /opportunities/{id}/opportunity-team-member。"
      },
      {
        "code": "EDIT_TEAM_MEMBER",
        "name": "编辑团队成员",
        "scope": "ENTITY",
        "entityCode": "opportunity-team-member",
        "operationKind": "UPDATE",
        "primaryDataAction": "UPDATE",
        "authzAction": "EDIT_TEAM_MEMBER",
        "httpMethod": "PATCH",
        "supportsBatch": false,
        "singleResultType": "ApiResponse<OpportunityTeamMemberDTO>",
        "position": "ROW",
        "triggerEvent": "OPEN_FORM",
        "description": "编辑团队成员角色、权限和备注。API：PATCH /opportunities/{id}/opportunity-team-member/{subId}。"
      },
      {
        "code": "DELETE_TEAM_MEMBER",
        "name": "删除团队成员",
        "scope": "ENTITY",
        "entityCode": "opportunity-team-member",
        "operationKind": "DELETE",
        "primaryDataAction": "DELETE",
        "authzAction": "DELETE_TEAM_MEMBER",
        "httpMethod": "DELETE",
        "supportsBatch": true,
        "singleResultType": "Void",
        "batchResultType": "BatchResultDTO",
        "position": "ROW",
        "triggerEvent": "CONFIRM_THEN_API",
        "description": "删除团队成员。API：DELETE /opportunities/{id}/opportunity-team-member/{subId}。"
      },
      {
        "code": "UPDATE_SALES_FORECAST",
        "name": "编辑销售预测",
        "scope": "BO",
        "operationKind": "UPDATE",
        "primaryDataAction": "UPDATE",
        "authzAction": "UPDATE_SALES_FORECAST",
        "httpMethod": "PATCH",
        "actionPath": "sales-forecast",
        "supportsBatch": false,
        "singleResultType": "ApiResponse<SalesForecastDTO>",
        "position": "DETAIL",
        "triggerEvent": "OPEN_FORM",
        "description": "独立编辑商机的销售预测字段（是否进入漏斗、是否承诺、预测类别），需专门角色授权。与普通编辑（EDIT_OPPORTUNITY）隔离。API：PATCH /opportunities/{id}/sales-forecast。"
      },
      {
        "code": "EDIT_STAGE_RECORD",
        "name": "编辑阶段记录",
        "scope": "ENTITY",
        "entityCode": "opportunity-stage-history",
        "operationKind": "UPDATE",
        "primaryDataAction": "UPDATE",
        "authzAction": "EDIT_STAGE_RECORD",
        "httpMethod": "PATCH",
        "supportsBatch": false,
        "singleResultType": "ApiResponse<OpportunityStageHistoryDTO>",
        "position": "DETAIL",
        "triggerEvent": "OPEN_FORM",
        "description": "编辑已有阶段推进记录的推进说明和附件，不改变阶段本身。用于补充会议纪要、方案评审、测试报告等资料。API：PATCH /opportunities/{id}/opportunity-stage-history/{subId}。"
      },
      {
        "code": "READ_NODE_DETAIL",
        "name": "按阶段编码查询节点详情",
        "scope": "ENTITY",
        "entityCode": "opportunity-stage-history",
        "operationKind": "CUSTOM",
        "primaryDataAction": "READ",
        "authzAction": "READ_NODE_DETAIL",
        "httpMethod": "POST",
        "actionPath": "node-detail",
        "supportsBatch": false,
        "singleResultType": "ApiResponse<SalesFlowNodeDetailView>",
        "position": "DETAIL",
        "triggerEvent": "API_CALL",
        "description": "按 stageCode 查询阶段推进历史节点的详情（推进说明 + 附件）。API：POST /opportunities/{id}/opportunity-stage-history/node-detail。"
      },
      {
        "code": "UPDATE_NODE_RECORD",
        "name": "按阶段编码编辑节点记录",
        "scope": "ENTITY",
        "entityCode": "opportunity-stage-history",
        "operationKind": "UPDATE",
        "primaryDataAction": "UPDATE",
        "authzAction": "UPDATE_NODE_RECORD",
        "httpMethod": "POST",
        "actionPath": "node-update",
        "supportsBatch": false,
        "singleResultType": "Void",
        "position": "DETAIL",
        "triggerEvent": "OPEN_FORM",
        "description": "按 stageCode 编辑阶段推进记录的推进说明和附件。API：POST /opportunities/{id}/opportunity-stage-history/node-update。"
      },
      {
        "code": "SUPPLEMENT_STAGE_DESCRIPTION",
        "name": "仅补充说明",
        "scope": "ENTITY",
        "entityCode": "opportunity-stage-history",
        "operationKind": "UPDATE",
        "primaryDataAction": "UPDATE",
        "authzAction": "SUPPLEMENT_STAGE_DESCRIPTION",
        "httpMethod": "PATCH",
        "actionPath": "supplement-description",
        "supportsBatch": false,
        "singleResultType": "ApiResponse<OpportunityStageHistoryDTO>",
        "position": "DETAIL",
        "triggerEvent": "OPEN_FORM",
        "description": "仅补充当前阶段的推进说明文字，不上传附件。API：PATCH /opportunities/{id}/opportunity-stage-history/{subId}/supplement-description。"
      },
      {
        "code": "SUPPLEMENT_STAGE_ATTACHMENT",
        "name": "仅补充附件",
        "scope": "ENTITY",
        "entityCode": "opportunity-stage-history",
        "operationKind": "UPDATE",
        "primaryDataAction": "UPDATE",
        "authzAction": "SUPPLEMENT_STAGE_ATTACHMENT",
        "httpMethod": "POST",
        "actionPath": "supplement-attachment",
        "supportsBatch": false,
        "singleResultType": "ApiResponse<OpportunityStageHistoryDTO>",
        "position": "DETAIL",
        "triggerEvent": "OPEN_FORM",
        "description": "仅补充当前阶段的附件，不修改推进说明。API：POST /opportunities/{id}/opportunity-stage-history/{subId}/supplement-attachment。"
      },
      {
        "code": "DELETE_STAGE_ATTACHMENT",
        "name": "删除阶段附件",
        "scope": "ENTITY",
        "entityCode": "opportunity-stage-attachment",
        "operationKind": "DELETE",
        "primaryDataAction": "DELETE",
        "authzAction": "DELETE_STAGE_ATTACHMENT",
        "httpMethod": "DELETE",
        "supportsBatch": true,
        "singleResultType": "Void",
        "batchResultType": "BatchResultDTO",
        "position": "ROW",
        "triggerEvent": "CONFIRM_THEN_API",
        "description": "删除阶段推进记录中的附件文件。API：DELETE /opportunities/{id}/opportunity-stage-history/{subId}/attachments/{attachmentId}。"
      },
      {
        "code": "SUMMARY",
        "name": "商机列表汇总",
        "scope": "GLOBAL",
        "operationKind": "CUSTOM",
        "primaryDataAction": "READ",
        "authzAction": "READ",
        "httpMethod": "POST",
        "actionPath": "summary",
        "supportsBatch": false,
        "singleResultType": "ApiResponse<OpportunityListSummaryDTO>",
        "position": "TOOLBAR",
        "triggerEvent": "API_CALL",
        "description": "查询商机列表底部汇总（受当前筛选条件影响，不受分页影响）。API：POST /opportunities/summary。"
      },
      {
        "code": "TRANSFER",
        "name": "商机转移",
        "scope": "BO",
        "operationKind": "CUSTOM",
        "primaryDataAction": "UPDATE",
        "authzAction": "TRANSFER",
        "httpMethod": "POST",
        "actionPath": "transfer",
        "supportsBatch": false,
        "singleResultType": "Void",
        "position": "DETAIL",
        "triggerEvent": "OPEN_FORM",
        "description": "变更商机所有人，同步处理团队成员记录。API：POST /opportunities/{id}/transfer。"
      },
      {
        "code": "SYNC_CBG_TO_ECP",
        "name": "同步商机至ECP",
        "scope": "BO",
        "operationKind": "CUSTOM",
        "primaryDataAction": "UPDATE",
        "authzAction": "SYNC",
        "httpMethod": "POST",
        "actionPath": "sync-cbg-to-ecp",
        "supportsBatch": false,
        "singleResultType": "ApiResponse<Boolean>",
        "position": "DETAIL",
        "triggerEvent": "API_CALL",
        "description": "单个业务机会同步到ECP（insert or update）。API：POST /opportunities/{id}/sync-cbg-to-ecp。"
      },
      {
        "code": "BATCH_SYNC_CBG_TO_ECP",
        "name": "批量同步商机至ECP",
        "scope": "GLOBAL",
        "operationKind": "CUSTOM",
        "primaryDataAction": "UPDATE",
        "authzAction": "SYNC",
        "httpMethod": "POST",
        "actionPath": "batch-sync-cbg-to-ecp",
        "supportsBatch": true,
        "singleResultType": "ApiResponse<Boolean>",
        "position": "TOOLBAR",
        "triggerEvent": "API_CALL",
        "description": "批量业务机会同步到ECP。API：POST /opportunities/batch-sync-cbg-to-ecp。"
      }
    ]
  }
}
