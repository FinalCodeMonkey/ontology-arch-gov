      "resourcePath": "/opportunities",
      "idField": "id",
      "idType": "LONG",
      "businessKeyField": "opportunity_code",
      "aggregateApiPolicy": {
        "listProjectionScope": "ROOT_SUMMARY",
        "readScope": "FULL_AGGREGATE",
        "createScope": "FULL_AGGREGATE",
        "updateScope": "ROOT_ENTITY_ONLY",
        "deleteScope": "CASCADE_AGGREGATE",
        "detailEmbedEntities": [
          "opportunity-scene",
          "opportunity-product",
          "opportunity-team-member",
          "opportunity-stage-history",
          "opportunity-quotation"
        ]
      },
      "searchEnabled": true,
      "batchEnabled": true
    },
    "boConfig": {
      "objectType": "MASTER_DETAIL",
      "nameField": "opportunity_name",
      "statusField": "status",
      "logicDeleteFlag": true,
      "versionFlag": false,
      "idStrategy": "SNOWFLAKE",
      "auditStrategy": "APPLICATION",
      "defaultSort": {
        "field": "created_time",
        "direction": "desc"
      }
    },
