    "boCode": "sales-activities",
    "boName": "销售活动",
    "description": "销售活动业务对象，采用主从明细聚合建模（主表 crm_customer_visit_record + 子表 crm_customer_visit_follow_up + 子表 customer_visit_team）。记录销售人员对客户的拜访活动，包含拜访客户、拜访时间、拜访场景(scenes BO)、联系人(contacts BO)、活动信息(富文本)、信息分享(存入visit-team-member)、记录人及下一步动作跟进。",
    "apiConfig": {
      "resourcePath": "/sales-activities",
      "idField": "id",
      "idType": "LONG",
      "aggregateApiPolicy": {
        "listProjectionScope": "ROOT_SUMMARY",
        "readScope": "FULL_AGGREGATE",
        "createScope": "FULL_AGGREGATE",
        "updateScope": "ROOT_ENTITY_ONLY",
        "deleteScope": "CASCADE_AGGREGATE",
        "orphanPolicy": "DENY_DELETE_WHEN_CHILD_EXISTS",
        "detailEmbedEntities": [
          "visit-follow-up",
          "visit-team-member"
        ]
      },
      "searchEnabled": true,
      "batchEnabled": true
    },
    "boConfig": {
      "objectType": "MASTER_DETAIL",
      "nameField": "visit_subject",
      "logicDeleteFlag": true,
      "versionFlag": false,
      "idStrategy": "SNOWFLAKE",
      "auditStrategy": "DATABASE",
      "defaultSort": {
        "field": "visit_time",
        "direction": "desc"
      }
    },
