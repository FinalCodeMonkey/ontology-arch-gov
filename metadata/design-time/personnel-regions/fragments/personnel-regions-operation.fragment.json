{
  "$schema": "https://authz.xbac/schemas/gov/bo-meta-fragment.schema.json",
  "tenantId": "cbg",
  "appCode": "crm",
  "boCode": "personnel-regions",
  "metaType": "OPERATION",
  "draftVersion": "1.0",
  "schemaVersion": "2.0",
  "content": {
    "operations": [
      {
        "code": "EDIT",
        "name": "编辑人员区域配置",
        "scope": "BO",
        "operationKind": "UPDATE",
        "primaryDataAction": "UPDATE",
        "authzAction": "UPDATE",
        "httpMethod": "POST",
        "actionPath": "update",
        "supportsBatch": false,
        "singleResultType": "PersonnelRegionDTO",
        "position": "ROW",
        "triggerEvent": "OPEN_FORM",
        "description": "编辑人员区域配置，可修改用户及区域。API：POST /personnel-regions/{id}/update。"
      },
      {
        "code": "DELETE",
        "name": "删除人员区域配置",
        "scope": "BO",
        "operationKind": "DELETE",
        "primaryDataAction": "DELETE",
        "authzAction": "DELETE",
        "httpMethod": "DELETE",
        "supportsBatch": true,
        "batchResultType": "BatchResultDTO",
        "position": "ROW",
        "triggerEvent": "CONFIRM_THEN_API",
        "description": "逻辑删除人员区域配置记录。标准 API：DELETE /personnel-regions/{id}，批量 API：DELETE /personnel-regions/batch。"
      },
      {
        "code": "EXPORT",
        "name": "导出",
        "scope": "BO",
        "operationKind": "EXPORT",
        "primaryDataAction": "READ",
        "authzAction": "EXPORT",
        "httpMethod": "POST",
        "actionPath": "export",
        "async": true,
        "singleResultType": "ExportTaskDTO",
        "position": "TOOLBAR",
        "triggerEvent": "API_CALL",
        "description": "导出人员区域配置数据为文件，支持按用户、区域等条件筛选。API：POST /personnel-regions/export。"
      },
      {
        "code": "IMPORT",
        "name": "导入",
        "scope": "BO",
        "operationKind": "IMPORT",
        "primaryDataAction": "CREATE",
        "authzAction": "IMPORT",
        "httpMethod": "POST",
        "actionPath": "import",
        "async": false,
        "singleResultType": "PersonnelRegionImportResultDTO",
        "position": "TOOLBAR",
        "triggerEvent": "OPEN_FORM",
        "description": "批量导入人员区域配置数据，执行用户存在性、区域有效性及组合唯一性校验。API：POST /personnel-regions/import。"
      },
      {
        "code": "QUERY_BY_REGION",
        "name": "按区域查询人员",
        "scope": "GLOBAL",
        "operationKind": "CUSTOM",
        "primaryDataAction": "READ",
        "authzAction": "READ",
        "httpMethod": "POST",
        "actionPath": "by-region",
        "supportsBatch": false,
        "singleResultType": "ApiResponse<List<PersonnelRegionView>>",
        "position": "TOOLBAR",
        "triggerEvent": "API_CALL",
        "description": "按区域编码查询人员列表，regionCode 为空时查全部。API：POST /personnel-regions/by-region。"
      },
      {
        "code": "QUERY_ORG_TREE",
        "name": "查询组织树",
        "scope": "GLOBAL",
        "operationKind": "CUSTOM",
        "primaryDataAction": "READ",
        "authzAction": "READ",
        "httpMethod": "POST",
        "actionPath": "org-tree",
        "supportsBatch": false,
        "singleResultType": "ApiResponse<List<TreeNode>>",
        "position": "TOOLBAR",
        "triggerEvent": "API_CALL",
        "description": "获取组织树，可选 rootOrgCode 限定机构范围。API：POST /personnel-regions/org-tree。"
      },
      {
        "code": "QUERY_ORG_TREES",
        "name": "查询所有机构树",
        "scope": "GLOBAL",
        "operationKind": "CUSTOM",
        "primaryDataAction": "READ",
        "authzAction": "READ",
        "httpMethod": "POST",
        "actionPath": "org-trees",
        "supportsBatch": false,
        "singleResultType": "ApiResponse<Map<String, List<TreeNode>>>",
        "position": "TOOLBAR",
        "triggerEvent": "API_CALL",
        "description": "批量获取所有已配置机构的组织树。API：POST /personnel-regions/org-trees。"
      },
      {
        "code": "QUERY_USERS_BY_DEPT",
        "name": "按部门查询用户",
        "scope": "GLOBAL",
        "operationKind": "CUSTOM",
        "primaryDataAction": "READ",
        "authzAction": "READ",
        "httpMethod": "POST",
        "actionPath": "users-by-dept",
        "supportsBatch": false,
        "singleResultType": "ApiResponse<PageApiResponse<Map<String, Object>>>",
        "position": "TOOLBAR",
        "triggerEvent": "API_CALL",
        "description": "按部门编码分页查询用户，支持关键字搜索。API：POST /personnel-regions/users-by-dept。"
      },
      {
        "code": "QUERY_USER_REGION_DEPT",
        "name": "查询用户区域和部门",
        "scope": "GLOBAL",
        "operationKind": "CUSTOM",
        "primaryDataAction": "READ",
        "authzAction": "READ",
        "httpMethod": "POST",
        "actionPath": "user-region-dept",
        "supportsBatch": false,
        "singleResultType": "ApiResponse<UserRegionDeptVO>",
        "position": "TOOLBAR",
        "triggerEvent": "API_CALL",
        "description": "根据用户 ID 查询其所在的凯捷区域和二级部门/大区/BG。API：POST /personnel-regions/user-region-dept。"
      }
    ]
  },
  "changeNote": [
    "v1.1 — EDIT httpMethod PATCH→POST 降级，新增 actionPath:\"update\"",
    "v1.1 — 新增 QUERY_BY_REGION / QUERY_ORG_TREE / QUERY_ORG_TREES / QUERY_USERS_BY_DEPT / QUERY_USER_REGION_DEPT 五个 GLOBAL/CUSTOM OPERATION",
    "POST /batch 由 BATCH_CREATE 自动推导（batchEnabled=true），无需显式声明",
    "CREATE / SEARCH / READ 等标准 CRUD 由发布服务自动推导，Fragment 不显式声明"
  ]
}
