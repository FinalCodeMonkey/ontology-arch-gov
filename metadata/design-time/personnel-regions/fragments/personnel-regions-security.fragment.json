{
  "$schema": "https://authz.xbac/schemas/gov/bo-meta-fragment.schema.json",
  "tenantId": "cbg",
  "appCode": "crm",
  "boCode": "personnel-regions",
  "metaType": "SECURITY",
  "draftVersion": "1.0",
  "schemaVersion": "2.0",
  "content": {
    "rowSecurity": {
      "fallbackScope": "NONE",
      "entriesByEntity": {
        "personnel-region": [
          "user_id",
          "region_code"
        ]
      }
    },
    "fieldSecurity": [],
    "authzProjection": {
      "description": "人员区域配置业务对象在 PSP 中的资源属性投影。运行时权限项通过 RES_DATA_BO + authz-bo-meta-model.id + act_code 定位 personnel-regions BO。",
      "usageNote": "用于数据权限、列表行级过滤。策略表达式中典型引用包括 res.user_id（按用户过滤）、res.region_code（按区域过滤）等。",
      "attributes": [
        {
          "code": "personnel_region_id",
          "name": "配置ID",
          "type": "LONG",
          "source": {
            "entityCode": "personnel-region",
            "fieldCode": "id"
          },
          "isPk": true,
          "filterable": false,
          "nullable": false,
          "onMissingValue": "DENY",
          "displayOrder": 10,
          "displayGroup": "基本标识",
          "description": "人员区域配置资源唯一标识。",
          "i18nKey": "auth.resource.res_personnel-region.attr.id"
        },
        {
          "code": "user_id",
          "name": "用户ID",
          "type": "STRING",
          "source": {
            "entityCode": "personnel-region",
            "fieldCode": "user_id"
          },
          "filterable": true,
          "nullable": false,
          "onMissingValue": "DENY",
          "displayOrder": 20,
          "displayGroup": "数据范围",
          "description": "关联的用户ID。典型表达式：res.user_id == sub.user_id。",
          "i18nKey": "auth.resource.res_personnel-region.attr.user_id",
          "valueRef": "users.id",
          "referenceModel": "users"
        },
        {
          "code": "region_code",
          "name": "区域编码",
          "type": "STRING",
          "source": {
            "entityCode": "personnel-region",
            "fieldCode": "region_code"
          },
          "filterable": true,
          "nullable": false,
          "onMissingValue": "DENY",
          "displayOrder": 30,
          "displayGroup": "资源属性",
          "description": "人员所属的区域编码（对应 sys_dict_data 中 type_code='region' 的 dict_value）。典型表达式：res.region_code == 'EAST_CHINA'。",
          "i18nKey": "auth.resource.res_personnel-region.attr.region_code"
        }
      ]
    }
  },
  "changeNote": [
    "personnel-regions 首版 SECURITY Fragment，含按 user_id 和 region_code 的行级过滤及 ABAC 资源属性投影"
  ]
}
