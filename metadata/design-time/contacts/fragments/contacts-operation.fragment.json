  "content": {
    "operations": [
      {
        "code": "CREATE",
        "name": "新建联系人",
        "scope": "BO",
        "operationKind": "CREATE",
        "primaryDataAction": "CREATE",
        "authzAction": "CREATE",
        "httpMethod": "POST",
        "supportsBatch": true,
        "singleResultType": "ContactDTO",
        "batchResultType": "BatchResultDTO",
        "position": "TOOLBAR",
        "triggerEvent": "OPEN_FORM",
        "description": "新建客户联系人，录入姓名、职位、分工、决策圈角色及所属部门。需指定 parent_id 关联所属客户。标准 API：POST /contacts，批量 API：POST /contacts/batch。"
      },
      {
        "code": "EDIT",
        "name": "编辑联系人",
        "scope": "BO",
        "operationKind": "UPDATE",
        "primaryDataAction": "UPDATE",
        "authzAction": "UPDATE",
        "httpMethod": "POST",
        "actionPath": "update",
        "supportsBatch": true,
        "singleResultType": "ContactDTO",
        "batchResultType": "BatchResultDTO",
        "position": "DETAIL",
        "triggerEvent": "OPEN_FORM",
        "description": "编辑联系人基本信息、决策圈角色及部门归属。标准 API：PATCH /contacts/{id}，批量 API：PATCH /contacts/batch。"
      },
      {
        "code": "DELETE",
