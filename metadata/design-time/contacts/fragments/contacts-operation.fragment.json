        "authzAction": "TRANSFER",
        "httpMethod": "POST",
        "actionPath": "transfer",
        "supportsBatch": false,
        "singleResultType": "ContactDTO",
        "position": "DETAIL",
        "triggerEvent": "OPEN_FORM",
        "description": "将联系人转移给新负责人，可选保留原负责人为团队成员。转移成功后操作不可恢复。API：POST /contacts/{id}/transfer。"
      },
      {
