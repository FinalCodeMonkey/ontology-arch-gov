{
  "$schema": "https://authz.xbac/schemas/gov/bo-meta-fragment.schema.json",
  "tenantId": "cbg",
  "appCode": "crm",
  "boCode": "contacts",
  "metaType": "OPERATION",
  "draftVersion": "1.0",
