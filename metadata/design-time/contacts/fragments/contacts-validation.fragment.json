{
  "$schema": "https://authz.xbac/schemas/gov/bo-meta-fragment.schema.json",
  "tenantId": "cbg",
  "appCode": "crm",
  "boCode": "contacts",
  "metaType": "VALIDATION",
  "draftVersion": "1.0",
  "schemaVersion": "2.0",
  "content": {
    "rules": [
      {
        "entityCode": "customer-contact",
        "fieldCode": "id",
        "required": true
      },
      {
        "entityCode": "customer-contact",
        "fieldCode": "customer_id",
        "required": true,
        "message": "必须选择所属客户"
      },
      {
        "entityCode": "customer-contact",
        "fieldCode": "name",
        "required": true,
        "max": 100,
        "unique": true,
        "message": "联系人姓名不能为空且不超过100字"
      },
      {
        "entityCode": "customer-contact",
        "fieldCode": "position",
        "max": 100,
        "enum": [
          {
            "value": "CEO",
            "label": "CEO"
          },
          {
            "value": "VP",
            "label": "VP"
          },
          {
            "value": "DIRECTOR",
            "label": "总监"
          },
          {
            "value": "MANAGER",
            "label": "经理"
          },
          {
            "value": "ENGINEER",
            "label": "工程师"
          }
        ],
        "message": "职位必须为预定义值之一"
      },
      {
        "entityCode": "customer-contact",
        "fieldCode": "report_to",
        "max": 100
      },
      {
        "entityCode": "customer-contact",
        "fieldCode": "key_business",
        "max": 200,
        "enum": [
          {
            "value": "JDM",
            "label": "JDM"
          },
          {
            "value": "DCN",
            "label": "DCN"
          },
          {
            "value": "AI_COMPUTE",
            "label": "智算"
          },
          {
            "value": "ESUN",
            "label": "ESUN"
          },
          {
            "value": "OPTICAL",
            "label": "光"
          },
          {
            "value": "CAMPUS",
            "label": "园区"
          }
        ],
        "message": "关联业务必须为预定义值之一"
      },
      {
        "entityCode": "customer-contact",
        "fieldCode": "relation_status",
        "required": true,
        "enum": [
          {
            "value": "EXCELLENT",
            "label": "★"
          },
          {
            "value": "POSITIVE",
            "label": "+"
          },
          {
            "value": "NEUTRAL",
            "label": "="
          },
          {
            "value": "NEGATIVE",
            "label": "-"
          },
          {
            "value": "NONE",
            "label": "x"
          }
        ],
        "message": "关系现状必须为预定义值之一"
      },
      {
        "entityCode": "customer-contact",
        "fieldCode": "dept_level1",
        "max": 100
      },
      {
        "entityCode": "customer-contact",
        "fieldCode": "dept_level2",
        "max": 100
      },
      {
        "entityCode": "customer-contact",
        "fieldCode": "dept_level3",
        "max": 100
      },
      {
        "entityCode": "customer-contact",
        "fieldCode": "mobile",
        "max": 32,
        "pattern": "^1[3-9]\\d{9}$",
        "message": "手机号格式不正确"
      },
      {
        "entityCode": "customer-contact",
        "fieldCode": "wechat",
        "max": 64
      },
      {
        "entityCode": "customer-contact",
        "fieldCode": "company_email",
        "max": 64,
        "pattern": "^[^@]+@[^@]+\\.[^@]+$",
        "message": "邮箱格式不正确"
      },
      {
        "entityCode": "customer-contact",
        "fieldCode": "interaction_frequency_target",
        "enum": [
          {
            "value": "YEAR",
            "label": "年"
          },
          {
            "value": "HALF_YEAR",
            "label": "半年"
          },
          {
            "value": "QUARTER",
            "label": "季度"
          },
          {
            "value": "MONTH",
            "label": "月"
          },
          {
            "value": "WEEK",
            "label": "周"
          }
        ],
        "message": "互动频率目标必须为预定义值之一"
      },
      {
        "entityCode": "customer-contact",
        "fieldCode": "gender",
        "enum": [
          {
            "value": "MALE",
            "label": "男"
          },
          {
            "value": "FEMALE",
            "label": "女"
          },
          {
            "value": "OTHER",
            "label": "其他"
          }
        ],
        "message": "性别必须为预定义值之一"
      },
      {
        "entityCode": "customer-contact",
        "fieldCode": "importance_level",
        "enum": [
          {
            "value": "HIGH",
            "label": "高"
          },
          {
            "value": "MEDIUM",
            "label": "中"
          },
          {
            "value": "LOW",
            "label": "低"
          }
        ],
        "message": "重要程度必须为预定义值之一"
      },
      {
        "entityCode": "customer-contact",
        "fieldCode": "purchase_role",
        "enum": [
          {
            "value": "DECIDING_MAKER",
            "label": "拍板者"
          },
          {
            "value": "DECISION_MAKER",
            "label": "决策者"
          },
          {
            "value": "EVALUATOR",
            "label": "评估者"
          },
          {
            "value": "USER",
            "label": "使用者"
          }
        ],
        "message": "采购角色必须为预定义值之一"
      },
      {
        "entityCode": "customer-contact",
        "fieldCode": "entry_date",
        "max": 10,
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "message": "入职时间格式应为 yyyy-MM-dd"
      },
      {
        "entityCode": "customer-contact",
        "fieldCode": "job_level",
        "enum": [
          {
            "value": "P",
            "label": "P"
          },
          {
            "value": "T",
            "label": "T"
          },
          {
            "value": "M",
            "label": "M"
          }
        ],
        "message": "职级必须为 P/T/M 之一"
      },
      {
        "entityCode": "customer-contact",
        "fieldCode": "id_card_no",
        "max": 18,
        "pattern": "^\\d{17}[\\dXx]$",
        "message": "身份证号格式不正确"
      },
      {
        "entityCode": "customer-contact",
        "fieldCode": "sales_owner_id",
        "max": 32
      },
      {
        "entityCode": "customer-contact",
        "fieldCode": "sales_owner_name",
        "max": 64
      },
      {
        "entityCode": "customer-contact",
        "fieldCode": "political_status",
        "enum": [
          {
            "value": "MASSES",
            "label": "群众"
          },
          {
            "value": "COMMUNIST_YOUTH_LEAGUE",
            "label": "共青团员"
          },
          {
            "value": "COMMUNIST_PARTY",
            "label": "中共党员"
          },
          {
            "value": "OTHER",
            "label": "其他"
          }
        ],
        "message": "政治面貌必须为预定义值之一"
      },
      {
        "entityCode": "customer-contact",
        "fieldCode": "religion",
        "enum": [
          {
            "value": "NONE",
            "label": "无"
          },
          {
            "value": "BUDDHISM",
            "label": "佛教"
          },
          {
            "value": "CHRISTIANITY",
            "label": "基督教"
          },
          {
            "value": "ISLAM",
            "label": "伊斯兰教"
          },
          {
            "value": "OTHER",
            "label": "其他"
          }
        ],
        "message": "宗教信仰必须为预定义值之一"
      },
      {
        "entityCode": "customer-contact",
        "fieldCode": "marital_status",
        "enum": [
          {
            "value": "UNMARRIED",
            "label": "未婚"
          },
          {
            "value": "MARRIED",
            "label": "已婚"
          },
          {
            "value": "SECRET",
            "label": "保密"
          }
        ],
        "message": "婚姻状况必须为预定义值之一"
      },
      {
        "entityCode": "customer-contact-resume",
        "fieldCode": "id",
        "required": true
      },
      {
        "entityCode": "customer-contact-resume",
        "fieldCode": "parent_id",
        "required": true
      },
      {
        "entityCode": "customer-contact-resume",
        "fieldCode": "period_start",
        "max": 7,
        "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
        "message": "任职开始时间格式应为 yyyy-MM"
      },
      {
        "entityCode": "customer-contact-resume",
        "fieldCode": "period_end",
        "max": 7,
        "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
        "message": "任职结束时间格式应为 yyyy-MM"
      },
      {
        "entityCode": "customer-contact-resume",
        "fieldCode": "company_name",
        "max": 200
      },
      {
        "entityCode": "customer-contact-resume",
        "fieldCode": "job_title",
        "max": 100
      },
      {
        "entityCode": "customer-contact-resume",
        "fieldCode": "awards",
        "max": 500
      },
      {
        "entityCode": "customer-contact-resume",
        "fieldCode": "certificates",
        "max": 500
      },
      {
        "entityCode": "customer-contact-education",
        "fieldCode": "id",
        "required": true
      },
      {
        "entityCode": "customer-contact-education",
        "fieldCode": "parent_id",
        "required": true
      },
      {
        "entityCode": "customer-contact-education",
        "fieldCode": "period_start",
        "max": 7,
        "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
        "message": "学习开始时间格式应为 yyyy-MM"
      },
      {
        "entityCode": "customer-contact-education",
        "fieldCode": "period_end",
        "max": 7,
        "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
        "message": "学习结束时间格式应为 yyyy-MM"
      },
      {
        "entityCode": "customer-contact-education",
        "fieldCode": "school_name",
        "max": 200
      },
      {
        "entityCode": "customer-contact-education",
        "fieldCode": "degree",
        "max": 64
      },
      {
        "entityCode": "customer-contact-education",
        "fieldCode": "major",
        "max": 100
      },
      {
        "entityCode": "contact-team-member",
        "fieldCode": "id",
        "required": true
      },
      {
        "entityCode": "contact-team-member",
        "fieldCode": "parent_id",
        "required": true
      },
      {
        "entityCode": "contact-team-member",
        "fieldCode": "user_id",
        "required": true,
        "max": 64,
        "message": "必须选择团队成员"
      },
      {
        "entityCode": "contact-team-member",
        "fieldCode": "member_name",
        "max": 100
      },
      {
        "entityCode": "contact-team-member",
        "fieldCode": "member_role",
        "required": true,
        "max": 50,
        "enum": [
          {
            "value": "SALES_OWNER",
            "label": "销售负责人"
          },
          {
            "value": "HARDWARE_SALES",
            "label": "硬件销售"
          },
          {
            "value": "SERVICE_SALES",
            "label": "服务销售"
          },
          {
            "value": "COLLABORATOR",
            "label": "协同跟进人"
          },
          {
            "value": "OTHER",
            "label": "其他"
          }
        ]
      },
      {
        "entityCode": "contact-team-member",
        "fieldCode": "permission",
        "required": true,
        "max": 10,
        "enum": [
          {
            "value": "READ_WRITE",
            "label": "读写"
          },
          {
            "value": "READ_ONLY",
            "label": "只读"
          }
        ],
        "message": "权限必须为读写或只读"
      },
      {
        "entityCode": "contact-team-member",
        "fieldCode": "related_teams",
        "max": 512
      },
      {
        "entityCode": "contact-team-member",
        "fieldCode": "remarks",
        "max": 300
      }
    ]
  },
  "changeNote": [
    "对齐 MODEL：customers_id 改为 customer_id",
    "补充 mobile/wechat/company_email/sales_owner_id/sales_owner_name 校验",
    "新增 gender/importance_level/purchase_role/job_level/id_card_no 校验",
    "name 字段添加 unique 约束",
    "新增 crm_customer-contact-resume 子实体校验规则（含 awards/certificates）",
    "新增 crm_customer-contact-education 子实体校验规则",
    "新增 contact-team-member 子实体校验规则",
    "新增 interaction_frequency_target 枚举校验",
    "position 添加枚举校验（CEO/VP/总监/经理/工程师）",
    "对齐界面原型：删除 division/in_decision_circle/decision_circle_role/annual_target/personal_info/resume.report_to 校验规则"
  ]
}
