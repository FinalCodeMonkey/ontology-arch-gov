  "content": {
    "boCode": "contacts",
    "boName": "客户联系人",
    "description": "客户联系人业务对象，主从明细聚合建模（MASTER_DETAIL）。主实体 crm_customer-contact 记录客户侧联系人姓名、职位、分工、决策圈角色及所属部门信息，通过 parent_id 关联所属客户；子实体 crm_customer-contact-resume 记录联系人历史履历，crm_customer-contact-education 记录联系人教育经历。PSP 中 bo_code 为 contacts。",
    "apiConfig": {
      "resourcePath": "/contacts",
      "idField": "id",
      "idType": "LONG",
      "businessKeyField": "name",
      "aggregateApiPolicy": {
        "listProjectionScope": "ROOT_SUMMARY",
        "readScope": "FULL_AGGREGATE",
        "createScope": "FULL_AGGREGATE",
        "updateScope": "ROOT_ENTITY_ONLY",
        "deleteScope": "CASCADE_AGGREGATE",
        "orphanPolicy": "DENY_DELETE_WHEN_CHILD_EXISTS",
        "detailEmbedEntities": [
          "customer-contact-resume",
          "customer-contact-education",
          "contact-team-member"
        ],
        "alternateAggregateApis": [
          {
            "code": "PATCH_CONTACT_AGGREGATE",
            "name": "增量更新完整联系人聚合",
            "method": "PATCH",
            "path": "/contacts/{id}/aggregate",
            "requestScope": "FULL_AGGREGATE_PATCH",
            "responseScope": "FULL_AGGREGATE",
            "resultType": "ApiResponse<ContactDTO>",
            "description": "显式增量更新完整聚合，允许同时提交主实体和子实体变更。"
          }
        ]
      },
      "searchEnabled": true,
      "batchEnabled": true
    },
    "boConfig": {
      "objectType": "MASTER_DETAIL",
      "nameField": "name",
      "statusField": "relation_status",
      "logicDeleteFlag": true,
      "versionFlag": false,
      "idStrategy": "SNOWFLAKE",
      "auditStrategy": "DATABASE",
      "defaultSort": {
        "field": "created_time",
        "direction": "desc"
      }
    },
