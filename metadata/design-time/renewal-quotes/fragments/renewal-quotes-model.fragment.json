            "semanticRole": "NORMAL",
            "filterable": true
          },
          {
            "code": "updated_time",
            "fieldName": "updatedTime",
            "columnName": "updated_time",
            "name": "更新时间",
            "type": "DATETIME",
            "isPk": false,
            "semanticRole": "NORMAL",
            "filterable": false
          },
          {
            "code": "created_by",
            "fieldName": "createdBy",
            "columnName": "created_by",
            "name": "创建人",
            "type": "STRING",
            "isPk": false,
            "semanticRole": "NORMAL",
            "filterable": false
          },
          {
            "code": "updated_by",
            "fieldName": "updatedBy",
            "columnName": "updated_by",
            "name": "更新人",
            "type": "STRING",
            "isPk": false,
            "semanticRole": "NORMAL",
            "filterable": false
          },
          {
            "code": "tenant_code",
            "fieldName": "tenantCode",
            "columnName": "tenant_code",
            "name": "租户编码",
            "type": "STRING",
            "isPk": false,
            "semanticRole": "NORMAL",
            "filterable": false
          }
        ]
      }
    ]
  },
  "changeNote": [
    "续保报价提交记录 BO 首版 MODEL Fragment",
    "parent_id 列映射为 code=inventory_id（语义化命名），CROSS_BO_REF → device-inventories.id",
    "inventory_no 为 CROSS_BO_DISPLAY（redundant=false，DDL 中无此列）",
    "crm_opportunity_code/name 暂作 NORMAL（CRM 系统外部编码，非本平台 BO 引用）",
    "submit_status 为 STATUS"
  ]
