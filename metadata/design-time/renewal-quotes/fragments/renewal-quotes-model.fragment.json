            "isPk": false,
            "semanticRole": "NORMAL",
            "filterable": false
          },
          {
            "code": "is_deleted",
            "fieldName": "isDeleted",
            "columnName": "is_deleted",
            "name": "逻辑删除",
            "type": "INTEGER",
            "isPk": false,
            "semanticRole": "NORMAL",
            "defaultValue": "0",
            "filterable": false
          },
          {
            "code": "created_time",
            "fieldName": "createdTime",
            "columnName": "created_time",
