{
  "$schema": "https://authz.xbac/schemas/gov/bo-meta-fragment.schema.json",
  "tenantId": "cbg",
  "appCode": "crm",
  "boCode": "renewal-quotes",
  "metaType": "OPERATION",
  "draftVersion": "1.0",
  "schemaVersion": "2.0",
  "content": {
    "operations": [
      {
        "code": "READ",
        "name": "查询续保报价详情",
        "scope": "BO",
        "operationKind": "CUSTOM",
        "primaryDataAction": "READ",
        "authzAction": "READ",
        "httpMethod": "GET",
        "supportsBatch": false,
        "singleResultType": "ApiResponse<RenewalQuoteVO>",
        "position": "ROW",
        "triggerEvent": "OPEN_FORM",
        "description": "按 ID 查询续保报价详情。API：GET /renewal-quotes/{id}。"
      },
      {
        "code": "CREATE",
        "name": "新建报价提交记录",
        "scope": "BO",
        "operationKind": "CREATE",
        "primaryDataAction": "CREATE",
        "authzAction": "CREATE",
        "httpMethod": "POST",
        "description": "创建续保报价提交记录。API：POST /renewal-quotes。"
      },
      {
        "code": "EDIT",
        "name": "编辑报价提交记录",
        "scope": "BO",
        "operationKind": "UPDATE",
        "primaryDataAction": "UPDATE",
        "authzAction": "UPDATE",
        "httpMethod": "POST",
        "actionPath": "update",
        "description": "编辑续保报价提交记录。API：POST /renewal-quotes/{id}/update。"
      },
      {
        "code": "DELETE",
        "name": "删除报价提交记录",
        "scope": "BO",
        "operationKind": "DELETE",
        "primaryDataAction": "DELETE",
        "authzAction": "DELETE",
        "httpMethod": "DELETE",
        "description": "逻辑删除报价提交记录。API：DELETE /renewal-quotes/{id}。"
      },
      {
        "code": "EXPORT",
        "name": "导出",
        "scope": "BO",
        "operationKind": "EXPORT",
        "primaryDataAction": "READ",
        "authzAction": "EXPORT",
        "httpMethod": "POST",
        "actionPath": "export",
        "async": true,
        "description": "导出报价提交记录。API：POST /renewal-quotes/export。"
      },
      {
        "code": "SUBMIT",
        "name": "提交续保报价",
        "scope": "BO",
        "operationKind": "STATE_CHANGE",
        "primaryDataAction": "UPDATE",
        "authzAction": "SUBMIT",
        "httpMethod": "POST",
        "actionPath": "submit",
        "supportsBatch": false,
        "singleResultType": "ApiResponse<RenewalQuoteVO>",
        "position": "DETAIL",
        "triggerEvent": "CONFIRM_THEN_API",
        "description": "提交续保报价，进入本地状态机流转，由 CRM 商机门面决定同步完成还是等待回调。API：POST /renewal-quotes/submit。"
      },
      {
        "code": "MARK_SUCCESS",
        "name": "手工标记成功",
        "scope": "BO",
        "operationKind": "STATE_CHANGE",
        "primaryDataAction": "UPDATE",
        "authzAction": "MARK_SUCCESS",
        "httpMethod": "POST",
        "actionPath": "mark-success",
        "supportsBatch": false,
        "singleResultType": "ApiResponse<RenewalQuoteVO>",
        "position": "ROW",
        "triggerEvent": "CONFIRM_THEN_API",
        "description": "手工将续保报价标记为成功。API：POST /renewal-quotes/{id}/mark-success。"
      },
      {
        "code": "MARK_FAILED",
        "name": "手工标记失败",
        "scope": "BO",
        "operationKind": "STATE_CHANGE",
        "primaryDataAction": "UPDATE",
        "authzAction": "MARK_FAILED",
        "httpMethod": "POST",
        "actionPath": "mark-failed",
        "supportsBatch": false,
        "singleResultType": "ApiResponse<RenewalQuoteVO>",
        "position": "ROW",
        "triggerEvent": "CONFIRM_THEN_API",
        "description": "手工将续保报价标记为失败。API：POST /renewal-quotes/{id}/mark-failed。"
      },
      {
        "code": "RETRY_SUBMIT",
        "name": "重新提交",
        "scope": "BO",
        "operationKind": "STATE_CHANGE",
        "primaryDataAction": "UPDATE",
        "authzAction": "RETRY_SUBMIT",
        "httpMethod": "POST",
        "actionPath": "retry-submit",
        "description": "对提交失败的记录重新提交到 CRM。API：POST /renewal-quotes/{id}/retry-submit。"
      },
      {
        "code": "QUERY_NEOCRM_OPPORTUNITIES",
        "name": "查询可关联 CRM 商机",
        "scope": "GLOBAL",
        "operationKind": "CUSTOM",
        "primaryDataAction": "READ",
        "authzAction": "QUERY_NEOCRM_OPPORTUNITIES",
        "httpMethod": "POST",
        "actionPath": "neocrm-opportunity-query",
        "supportsBatch": false,
        "singleResultType": "ApiResponse<PageResult<RenewalOpportunityVO>>",
        "position": "TOOLBAR",
        "triggerEvent": "API_CALL",
        "description": "查询当前用户的工号可关联的已有 CRM 商机列表。API：POST /renewal-quotes/neocrm-opportunity-query。"
      },
      {
        "code": "CHECK_NEOCRM_OPPORTUNITY_COMPLIANCE",
        "name": "校验 CRM 商机合规性",
        "scope": "GLOBAL",
        "operationKind": "CUSTOM",
        "primaryDataAction": "READ",
        "authzAction": "CHECK_NEOCRM_OPPORTUNITY_COMPLIANCE",
        "httpMethod": "POST",
        "actionPath": "neocrm-opportunity-compliance-check",
        "supportsBatch": false,
        "singleResultType": "ApiResponse<RenewalOpportunityComplianceCheckVO>",
        "position": "TOOLBAR",
        "triggerEvent": "API_CALL",
        "description": "校验商机名称和客户名称是否符合 CRM 阻断规则。API：POST /renewal-quotes/neocrm-opportunity-compliance-check。"
      },
      {
        "code": "QUERY_NEOCRM_OPPORTUNITY_OPTIONS",
        "name": "查询 CRM 商机下拉选项",
        "scope": "GLOBAL",
        "operationKind": "CUSTOM",
        "primaryDataAction": "READ",
        "authzAction": "QUERY_NEOCRM_OPPORTUNITY_OPTIONS",
        "httpMethod": "GET",
        "actionPath": "neocrm-opportunity-options",
        "supportsBatch": false,
        "singleResultType": "ApiResponse<RenewalOpportunityOptionGroupsVO>",
        "position": "TOOLBAR",
        "triggerEvent": "API_CALL",
        "description": "根据字段编码查询 CRM 新商机下拉选项分组。API：GET /renewal-quotes/neocrm-opportunity-options。"
      },
      {
        "code": "QUERY_NEOCRM_OPPORTUNITY_STAGES",
        "name": "查询 CRM 商机阶段",
        "scope": "GLOBAL",
        "operationKind": "CUSTOM",
        "primaryDataAction": "READ",
        "authzAction": "QUERY_NEOCRM_OPPORTUNITY_STAGES",
        "httpMethod": "GET",
        "actionPath": "neocrm-opportunity-stages",
        "supportsBatch": false,
        "singleResultType": "ApiResponse<List<RenewalOptionItemVO>>",
        "position": "TOOLBAR",
        "triggerEvent": "API_CALL",
        "description": "根据 entityTypeApiKey 查询 CRM 商机阶段列表，用于采购阶段下拉。API：GET /renewal-quotes/neocrm-opportunity-stages。"
      },
      {
        "code": "QUERY_SERVICE_PACKAGES",
        "name": "查询维保服务包",
        "scope": "GLOBAL",
        "operationKind": "CUSTOM",
        "primaryDataAction": "READ",
        "authzAction": "QUERY_SERVICE_PACKAGES",
        "httpMethod": "POST",
        "actionPath": "service-packages-query",
        "supportsBatch": false,
        "singleResultType": "ApiResponse<List<RenewalServicePackageOptionVO>>",
        "position": "TOOLBAR",
        "triggerEvent": "API_CALL",
        "description": "根据产品编码批量查询维保服务选项。API：POST /renewal-quotes/service-packages-query。"
      },
      {
        "code": "QUERY_ECP_DEVICES",
        "name": "查询 ECP 续保设备",
        "scope": "GLOBAL",
        "operationKind": "CUSTOM",
        "primaryDataAction": "READ",
        "authzAction": "QUERY_ECP_DEVICES",
        "httpMethod": "POST",
        "actionPath": "ecp-devices-query",
        "supportsBatch": false,
        "singleResultType": "ApiResponse<PageResult<EcpRenewalQuoteDeviceVO>>",
        "position": "TOOLBAR",
        "triggerEvent": "API_CALL",
        "description": "ECP 查询续保报价关联设备列表（支持分页/全量）。API：POST /renewal-quotes/ecp-devices-query。"
      }
    ]
  },
  "changeNote": [
    "v1.1 — 新增 SEARCH(search)、SUBMIT、MARK_SUCCESS、MARK_FAILED 等 STATE_CHANGE OPERATION",
    "v1.1 — 新增 QUERY_NEOCRM_OPPORTUNITIES / CHECK_NEOCRM_OPPORTUNITY_COMPLIANCE / QUERY_NEOCRM_OPPORTUNITY_OPTIONS / QUERY_NEOCRM_OPPORTUNITY_STAGES / QUERY_SERVICE_PACKAGES / QUERY_ECP_DEVICES 六个 GLOBAL 跨系统查询 OPERATION",
    "SEARCH(search) 替代原 POST /query 路径，消除保留关键字违规"
  ]
}
