{
  "$schema": "https://authz.xbac/schemas/gov/bo-meta-fragment.schema.json",
  "tenantId": "cbg",
  "appCode": "crm",
  "boCode": "device-inventories",
  "metaType": "OPERATION",
  "draftVersion": "1.0",
  "schemaVersion": "2.0",
  "content": {
    "operations": [
      {
        "code": "SAVE",
        "name": "保存盘点单",
        "scope": "BO",
        "operationKind": "CREATE",
        "primaryDataAction": "CREATE",
        "authzAction": "CREATE",
        "httpMethod": "POST",
        "actionPath": "save",
        "supportsBatch": false,
        "singleResultType": "ApiResponse<InventoryDetailVO>",
        "position": "DETAIL",
        "triggerEvent": "API_CALL",
        "description": "保存盘点单（新建或更新），含盘点类型、状态、备注及明细列表。ID 为空时新建，非空时更新。API：POST /device-inventories/save。"
      },
      {
        "code": "COPY",
        "name": "复制盘点单",
        "scope": "BO",
        "operationKind": "CUSTOM",
        "primaryDataAction": "CREATE",
        "authzAction": "CREATE",
        "httpMethod": "POST",
        "actionPath": "copy",
        "supportsBatch": false,
        "singleResultType": "ApiResponse<InventoryDetailVO>",
        "position": "ROW",
        "triggerEvent": "API_CALL",
        "description": "复制已有盘点单生成新的草稿盘点单，包含明细快照。API：POST /device-inventories/{id}/copy。"
      },
      {
        "code": "DELETE",
        "name": "删除盘点单",
        "scope": "BO",
        "operationKind": "DELETE",
        "primaryDataAction": "DELETE",
        "authzAction": "DELETE",
        "httpMethod": "DELETE",
        "supportsBatch": false,
        "singleResultType": "Void",
        "position": "ROW",
        "triggerEvent": "CONFIRM_THEN_API",
        "description": "物理删除盘点单，仅草稿状态（DRAFT）可删除。级联删除明细记录。API：DELETE /device-inventories/{id}。"
      },
      {
        "code": "EXPORT",
        "name": "导出盘点设备",
        "scope": "GLOBAL",
        "operationKind": "EXPORT",
        "primaryDataAction": "READ",
        "authzAction": "EXPORT",
        "httpMethod": "POST",
        "actionPath": "export",
        "async": true,
        "singleResultType": "Void",
        "position": "DETAIL",
        "triggerEvent": "API_CALL",
        "description": "按盘点单导出盘点内设备信息为 Excel。API：POST /device-inventories/export。"
      },
      {
        "code": "ONE_CLICK_QUOTE",
        "name": "一键报价",
        "scope": "BO",
        "operationKind": "CUSTOM",
        "primaryDataAction": "CREATE",
        "authzAction": "QUOTE",
        "httpMethod": "POST",
        "actionPath": "quote",
        "supportsBatch": false,
        "position": "DETAIL",
        "triggerEvent": "OPEN_FORM",
        "description": "基于盘点单设备明细一键生成报价单，关联商机编码。触发 OneClickQuoteDialog 对话框选择商机后生成报价。"
      },
      {
        "code": "BATCH_DELETE_DETAIL",
        "name": "批量删除明细",
        "scope": "ENTITY",
        "entityCode": "device-inventory-detail",
        "operationKind": "DELETE",
        "primaryDataAction": "DELETE",
        "authzAction": "UPDATE",
        "httpMethod": "POST",
        "actionPath": "batch-delete-details",
        "supportsBatch": true,
        "batchResultType": "BatchResultDTO",
        "position": "DETAIL",
        "triggerEvent": "CONFIRM_THEN_API",
        "description": "批量删除盘点明细中选中的设备行。API：POST /device-inventories/{id}/save-incremental（增量保存删除标记）。"
      },
      {
        "code": "BATCH_SET_MAINTENANCE",
        "name": "批量设置维保服务",
        "scope": "ENTITY",
        "entityCode": "device-inventory-detail",
        "operationKind": "UPDATE",
        "primaryDataAction": "UPDATE",
        "authzAction": "UPDATE",
        "httpMethod": "POST",
        "actionPath": "batch-set-maintenance",
        "supportsBatch": true,
        "batchResultType": "BatchResultDTO",
        "position": "DETAIL",
        "triggerEvent": "OPEN_FORM",
        "description": "批量设置选中明细行的维保服务字段。触发 EquipBatchMaintenanceDialog 对话框。"
      },
      {
        "code": "BATCH_SET_WARRANTY",
        "name": "批量修改保修期",
        "scope": "ENTITY",
        "entityCode": "device-inventory-detail",
        "operationKind": "UPDATE",
        "primaryDataAction": "UPDATE",
        "authzAction": "UPDATE",
        "httpMethod": "POST",
        "actionPath": "batch-set-warranty",
        "supportsBatch": true,
        "batchResultType": "BatchResultDTO",
        "position": "DETAIL",
        "triggerEvent": "OPEN_FORM",
        "description": "批量修改选中明细行的保修开始/结束日期。触发 EquipBatchWarrantyDialog 对话框。"
      },
      {
        "code": "MANUAL_INVENTORY_SESSION",
        "name": "手工盘点会话",
        "scope": "GLOBAL",
        "operationKind": "CUSTOM",
        "primaryDataAction": "CREATE",
        "authzAction": "INVENTORY",
        "httpMethod": "POST",
        "actionPath": "manual-sessions",
        "supportsBatch": false,
        "position": "TOOLBAR",
        "triggerEvent": "API_CALL",
        "description": "以设备序列号为种子创建手工盘点会话（Redis 临时会话），支持分页查询、脏数据保存、提交生成盘点单。API：POST /device-inventories/manual-sessions。"
      },
      {
        "code": "QUERY_MANUAL_SESSION_ITEMS",
        "name": "查询手工盘点会话明细",
        "scope": "GLOBAL",
        "operationKind": "CUSTOM",
        "primaryDataAction": "READ",
        "authzAction": "READ",
        "httpMethod": "POST",
        "actionPath": "manual-sessions-items",
        "supportsBatch": false,
        "singleResultType": "ApiResponse<ManualInventorySessionPageVO>",
        "position": "DETAIL",
        "triggerEvent": "API_CALL",
        "description": "查询手工盘点会话的分页明细数据，sessionId 通过 RequestParam 传入。API：POST /device-inventories/manual-sessions-items。"
      },
      {
        "code": "SAVE_MANUAL_SESSION_DIRTY",
        "name": "保存手工盘点会话脏数据",
        "scope": "GLOBAL",
        "operationKind": "CUSTOM",
        "primaryDataAction": "UPDATE",
        "authzAction": "UPDATE",
        "httpMethod": "POST",
        "actionPath": "manual-sessions-dirty",
        "supportsBatch": false,
        "singleResultType": "Void",
        "position": "DETAIL",
        "triggerEvent": "API_CALL",
        "description": "保存手工盘点会话中页内修改的脏数据，sessionId 通过 RequestParam 传入。API：POST /device-inventories/manual-sessions-dirty。"
      },
      {
        "code": "COMMIT_MANUAL_SESSION",
        "name": "提交手工盘点会话",
        "scope": "GLOBAL",
        "operationKind": "CUSTOM",
        "primaryDataAction": "UPDATE",
        "authzAction": "UPDATE",
        "httpMethod": "POST",
        "actionPath": "manual-sessions-commit",
        "supportsBatch": false,
        "singleResultType": "ApiResponse<InventoryDetailVO>",
        "position": "DETAIL",
        "triggerEvent": "CONFIRM_THEN_API",
        "description": "提交手工盘点会话，将临时会话中的脏数据合并后生成盘点单，sessionId 通过 RequestParam 传入。API：POST /device-inventories/manual-sessions-commit。"
      },
      {
        "code": "DOWNLOAD_IMPORT_TEMPLATE",
        "name": "下载导入模板",
        "scope": "GLOBAL",
        "operationKind": "EXPORT",
        "primaryDataAction": "READ",
        "authzAction": "IMPORT",
        "httpMethod": "GET",
        "actionPath": "import-template",
        "async": true,
        "singleResultType": "Void",
        "position": "TOOLBAR",
        "triggerEvent": "API_CALL",
        "description": "下载盘点导入 Excel 模板文件，直接写入 HttpServletResponse。API：GET /device-inventories/import-template。"
      },
      {
        "code": "PARSE_IMPORT_HEADER",
        "name": "解析导入表头",
        "scope": "GLOBAL",
        "operationKind": "IMPORT",
        "primaryDataAction": "CREATE",
        "authzAction": "IMPORT",
        "httpMethod": "POST",
        "actionPath": "import-parse-header",
        "supportsBatch": false,
        "singleResultType": "ApiResponse<InventoryImportHeaderParseVO>",
        "position": "TOOLBAR",
        "triggerEvent": "API_CALL",
        "description": "解析导入 Excel 文件的表头，返回字段列表供前端配置映射。API：POST /device-inventories/import-parse-header。"
      },
      {
        "code": "QUERY_IMPORT_SESSION_PAGE",
        "name": "查询导入会话分页",
        "scope": "GLOBAL",
        "operationKind": "CUSTOM",
        "primaryDataAction": "READ",
        "authzAction": "READ",
        "httpMethod": "POST",
        "actionPath": "import-sessions-page-query",
        "supportsBatch": false,
        "singleResultType": "ApiResponse<InventoryImportSessionPageVO>",
        "position": "DETAIL",
        "triggerEvent": "API_CALL",
        "description": "分页查询导入临时会话的预览数据，sessionId 通过 RequestParam 传入。API：POST /device-inventories/import-sessions-page-query。"
      },
      {
        "code": "QUERY_SESSION_PRODUCT_MODELS",
        "name": "查询会话产品型号",
        "scope": "GLOBAL",
        "operationKind": "CUSTOM",
        "primaryDataAction": "READ",
        "authzAction": "READ",
        "httpMethod": "GET",
        "actionPath": "sessions-product-models",
        "supportsBatch": false,
        "singleResultType": "ApiResponse<List<String>>",
        "position": "DETAIL",
        "triggerEvent": "API_CALL",
        "description": "跨 session 类型查询会话中的产品型号列表，sessionId 和 sessionType 通过 RequestParam 传入。API：GET /device-inventories/sessions-product-models。"
      },
      {
        "code": "QUERY_IMPORT_SESSION_PROGRESS",
        "name": "查询导入会话进度",
        "scope": "GLOBAL",
        "operationKind": "CUSTOM",
        "primaryDataAction": "READ",
        "authzAction": "READ",
        "httpMethod": "GET",
        "actionPath": "import-sessions-progress",
        "supportsBatch": false,
        "singleResultType": "ApiResponse<InventoryImportSessionProgressVO>",
        "position": "DETAIL",
        "triggerEvent": "API_CALL",
        "description": "查询导入临时会话的处理进度，sessionId 通过 RequestParam 传入。API：GET /device-inventories/import-sessions-progress。"
      },
      {
        "code": "SAVE_IMPORT_SESSION_DIRTY",
        "name": "保存导入会话脏数据",
        "scope": "GLOBAL",
        "operationKind": "CUSTOM",
        "primaryDataAction": "UPDATE",
        "authzAction": "UPDATE",
        "httpMethod": "POST",
        "actionPath": "import-sessions-dirty",
        "supportsBatch": false,
        "singleResultType": "Void",
        "position": "DETAIL",
        "triggerEvent": "API_CALL",
        "description": "保存导入会话中页内修改的脏数据，sessionId 通过 RequestParam 传入。API：POST /device-inventories/import-sessions-dirty。"
      },
      {
        "code": "COMMIT_IMPORT_SESSION",
        "name": "提交导入会话",
        "scope": "GLOBAL",
        "operationKind": "CUSTOM",
        "primaryDataAction": "UPDATE",
        "authzAction": "UPDATE",
        "httpMethod": "POST",
        "actionPath": "import-sessions-commit",
        "supportsBatch": false,
        "singleResultType": "ApiResponse<InventoryCommitResultVO>",
        "position": "DETAIL",
        "triggerEvent": "CONFIRM_THEN_API",
        "description": "提交导入会话，合并脏数据后保存盘点单，sessionId 通过 RequestParam 传入。API：POST /device-inventories/import-sessions-commit。"
      }
    ]
  }
}
