  "content": {
    "boCode": "device-inventories",
    "boName": "设备盘点单",
    "description": "设备盘点单业务对象，采用主从明细聚合建模（主表 crm_device-inventory + 明细子表 crm_device-inventory-detail）。以盘点单号（inventory_no）作为业务主键，管理设备盘点过程及结果。支持手工盘点和导入盘点两种方式，盘点明细记录设备序列号、产品信息、保修信息及异常说明。注意：当前后端 API 路径为 /api/inventories，元数据 resourcePath 为 /device-inventories，后续将重构后端路由对齐。",
    "apiConfig": {
      "resourcePath": "/device-inventories",
      "idField": "id",
      "idType": "LONG",
      "businessKeyField": "inventory_no",
      "aggregateApiPolicy": {
        "listProjectionScope": "ROOT_SUMMARY",
        "readScope": "FULL_AGGREGATE",
        "createScope": "FULL_AGGREGATE",
        "updateScope": "FULL_AGGREGATE_PATCH",
        "deleteScope": "CASCADE_AGGREGATE",
        "orphanPolicy": "DENY_DELETE_WHEN_CHILD_EXISTS",
        "detailEmbedEntities": [
          "device-inventory-detail"
        ]
      },
      "searchEnabled": true,
      "batchEnabled": true
    },
    "boConfig": {
      "objectType": "MASTER_DETAIL",
      "nameField": "inventory_no",
      "statusField": "inventory_status",
      "logicDeleteFlag": true,
      "versionFlag": false,
      "idStrategy": "SNOWFLAKE",
      "auditStrategy": "DATABASE",
      "defaultSort": {
        "field": "created_time",
        "direction": "desc"
      }
