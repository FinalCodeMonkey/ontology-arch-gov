  "changeNote": [
    "MCR BO 首版 VALIDATION Fragment，从 customers BO 迁移并调整 entityCode 为 crm_customer-relation",
    "修正 customer-competition/customer-industry-strategy/customer-infra-architecture 的 fieldCode：customer_id → parent_id（与 MODEL Fragment 一致，子实体通过 parent_id 关联聚合根）",
    "补全 customer-relation 根实体字段约束：owner_user_id/department_code/department_name/region/latest_visitor_id/latest_visitor_name/responsible_pre_sales_id/responsible_pre_sales_name/service_sales_id/service_sales_name max 长度",
    "新增 customer-team-member member_role 枚举(SALES_OWNER/PRE_SALES/SERVICE_SALES/COLLABORATOR/OTHER) + permission 枚举(READ_WRITE/READ_ONLY) + related_teams/remark max",
    "补全 customer-competition 字段约束：competitor_name/strategic_intent/recent_action_* max 长度",
    "补全 customer-competition-member 字段约束：user_id max 64 + member_name/member_role/remark",
    "补全 customer-competition-sale 字段约束：sort_no min 1 + sales_year/product_category/product_name/annual_sales/next_year_target max 长度",
    "补全 customer-industry-strategy 字段约束：main_product/revenue_data/gross_margin_data/corp_strategy/ai_strategy/infra_plan/version_no/version_remark max 长度",
    "补全 customer-industry-strategy-member 字段约束：user_id max 64 + member_name/member_role/remark",
    "补全 customer-industry-biz 字段约束：sort_no min 1 + biz_name required/max 200 + biz_result max 2000",
    "补全 customer-infra-architecture-member 字段约束：user_id max 64 + member_name/member_role/remark",
    "新增 customer-infra-architecture 校验规则：arch_name/server_info/nic_info/network_info/module_info/pod_usage/pod_count/shortlist_date/gray_date/mass_production_date/eol_date/diagram_file_id/diagram_file_name required",
    "新增 customer-infra-architecture arch_category 枚举：GENERAL_COMPUTE(通算架构)/AI_COMPUTE(智算架构)"
  ]
