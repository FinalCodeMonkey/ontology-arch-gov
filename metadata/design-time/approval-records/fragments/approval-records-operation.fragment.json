{
  "$schema": "https://authz.xbac/schemas/gov/bo-meta-fragment.schema.json",
  "tenantId": "cbg",
  "appCode": "crm",
  "boCode": "approval-records",
  "metaType": "OPERATION",
  "draftVersion": "1.0",
  "schemaVersion": "2.0",
  "content": {
    "operations": [
      {
        "code": "CREATE",
        "name": "创建审批记录",
        "scope": "BO",
        "operationKind": "CREATE",
        "primaryDataAction": "CREATE",
        "authzAction": "CREATE",
        "httpMethod": "POST",
        "description": "创建审批记录，通常由业务对象提交审批时自动触发。API：POST /approval-records。"
      },
      {
        "code": "EDIT",
        "name": "编辑审批记录",
        "scope": "BO",
        "operationKind": "UPDATE",
        "primaryDataAction": "UPDATE",
        "authzAction": "UPDATE",
        "httpMethod": "POST",
        "actionPath": "update",
        "description": "编辑审批记录（如 BPM 回写状态/处理人）。API：POST /approval-records/{id}/update。"
      },
      {
        "code": "DELETE",
        "name": "删除审批记录",
        "scope": "BO",
        "operationKind": "DELETE",
        "primaryDataAction": "DELETE",
        "authzAction": "DELETE",
        "httpMethod": "DELETE",
        "description": "逻辑删除审批记录。API：DELETE /approval-records/{id}。"
      },
      {
        "code": "EXPORT",
        "name": "导出",
        "scope": "BO",
        "operationKind": "EXPORT",
        "primaryDataAction": "READ",
        "authzAction": "EXPORT",
        "httpMethod": "POST",
        "actionPath": "export",
        "async": true,
        "description": "导出审批记录。API：POST /approval-records/export。"
      },
      {
        "code": "REVOKE",
        "name": "撤回审批",
        "scope": "BO",
        "operationKind": "STATE_CHANGE",
        "primaryDataAction": "UPDATE",
        "authzAction": "REVOKE",
        "httpMethod": "POST",
        "actionPath": "revoke",
        "description": "撤回审批申请。API：POST /approval-records/{id}/revoke。"
      }
    ]
  },
  "changeNote": [
    "审批记录 BO 首版 OPERATION Fragment",
    "标准 CRUD + REVOKE 状态变更操作",
    "LIST/READ 由发布服务自动补齐"
  ]
}
