    "boName": "审批记录",
    "description": "审批记录业务对象，通用设计，不限定特定业务域。记录任意业务对象的审批流程信息，通过 biz_type + biz_id 多态引用业务对象，关联 BPM 流程实例。提交人、发起人、当前处理人、撤回人均通过 CROSS_BO_REF 引用 users BO。PSP 中 bo_code 为 approval-records。",
    "apiConfig": {
      "resourcePath": "/approval-records",
      "idField": "id",
      "idType": "LONG",
      "aggregateApiPolicy": {
        "listProjectionScope": "ROOT_SUMMARY",
        "readScope": "ROOT_ENTITY_ONLY",
        "createScope": "ROOT_ENTITY_ONLY",
        "updateScope": "ROOT_ENTITY_ONLY",
        "deleteScope": "ROOT_ENTITY_ONLY",
        "orphanPolicy": "DENY_DELETE_WHEN_CHILD_EXISTS"
      },
      "searchEnabled": true,
      "batchEnabled": true
    },
    "boConfig": {
      "objectType": "SINGLE",
      "nameField": "process_name",
      "statusField": "status",
      "logicDeleteFlag": true,
      "versionFlag": false,
      "idStrategy": "SNOWFLAKE",
      "auditStrategy": "DATABASE",
      "defaultSort": {
