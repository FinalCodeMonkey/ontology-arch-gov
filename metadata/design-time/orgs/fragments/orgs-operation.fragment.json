{
  "$schema": "https://authz.xbac/schemas/gov/bo-meta-fragment.schema.json",
  "tenantId": "cbg",
  "appCode": "crm",
  "boCode": "orgs",
  "metaType": "OPERATION",
  "draftVersion": "1.0",
  "schemaVersion": "2.0",
  "content": {
    "operations": [
      {
        "code": "CREATE",
        "name": "新建组织",
        "scope": "BO",
        "operationKind": "CREATE",
        "primaryDataAction": "CREATE",
        "authzAction": "CREATE",
        "httpMethod": "POST",
        "supportsBatch": true,
        "singleResultType": "OrgDTO",
        "batchResultType": "BatchResultDTO",
        "position": "TOOLBAR",
        "triggerEvent": "OPEN_FORM",
        "description": "新建组织节点，需指定上级组织 parent_org_id，支持批量创建。标准 API：POST /orgs，批量 API：POST /orgs/batch。"
      },
      {
        "code": "EDIT",
        "name": "编辑组织",
        "scope": "BO",
        "operationKind": "UPDATE",
        "primaryDataAction": "UPDATE",
        "authzAction": "UPDATE",
        "httpMethod": "PATCH",
        "supportsBatch": true,
        "singleResultType": "OrgDTO",
        "batchResultType": "BatchResultDTO",
        "position": "DETAIL",
        "triggerEvent": "OPEN_FORM",
        "description": "编辑组织基本信息，包括部门编码、名称、层级、类型、负责人、分管负责人、HRBP 列表等。标准 API：PATCH /orgs/{id}，批量 API：PATCH /orgs/batch。"
      },
      {
        "code": "DELETE",
        "name": "删除组织",
        "scope": "BO",
        "operationKind": "DELETE",
        "primaryDataAction": "DELETE",
        "authzAction": "DELETE",
        "httpMethod": "DELETE",
        "supportsBatch": true,
        "batchResultType": "BatchResultDTO",
        "position": "ROW",
        "triggerEvent": "CONFIRM_THEN_API",
        "description": "逻辑删除组织节点。存在子组织时受 orphanPolicy=DENY_DELETE_WHEN_CHILD_EXISTS 约束，需先清理下级组织。标准 API：DELETE /orgs/{id}，批量 API：DELETE /orgs/batch。"
      },
      {
        "code": "EXPORT",
        "name": "导出",
        "scope": "BO",
        "operationKind": "EXPORT",
        "primaryDataAction": "READ",
        "authzAction": "EXPORT",
        "httpMethod": "POST",
        "actionPath": "export",
        "async": true,
        "singleResultType": "ExportTaskDTO",
        "position": "TOOLBAR",
        "triggerEvent": "API_CALL",
        "description": "导出组织架构数据为文件，支持按部门层级、类型等条件筛选。API：POST /orgs/export。"
      },
      {
        "code": "IMPORT",
        "name": "导入",
        "scope": "BO",
        "operationKind": "IMPORT",
        "primaryDataAction": "CREATE",
        "authzAction": "IMPORT",
        "httpMethod": "POST",
        "actionPath": "import",
        "async": false,
        "singleResultType": "OrgImportResultDTO",
        "position": "TOOLBAR",
        "triggerEvent": "OPEN_FORM",
        "description": "批量导入组织架构数据，执行必填和枚举校验。API：POST /orgs/import。"
      }
    ]
  },
  "changeNote": [
    "组织架构 BO 首版 OPERATION Fragment",
    "标准 CRUD（LIST/READ）由发布服务从 MODEL.apiConfig 自动生成，无需显式声明",
    "PSP 端现有权限项 act_code=READ 保持兼容"
  ]
}
