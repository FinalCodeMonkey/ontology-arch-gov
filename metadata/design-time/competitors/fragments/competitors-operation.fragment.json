{
  "$schema": "https://authz.xbac/schemas/gov/bo-meta-fragment.schema.json",
  "tenantId": "cbg",
  "appCode": "crm",
  "boCode": "competitors",
  "metaType": "OPERATION",
  "draftVersion": "1.0",
  "schemaVersion": "2.0",
  "content": {
    "operations": [
      {
        "code": "CREATE",
        "name": "新建竞争对手",
        "scope": "BO",
        "operationKind": "CREATE",
        "primaryDataAction": "CREATE",
        "authzAction": "CREATE",
        "httpMethod": "POST",
        "supportsBatch": true,
        "singleResultType": "ApiResponse<CompetitorDTO>",
        "batchResultType": "BatchResultDTO",
        "position": "TOOLBAR",
        "triggerEvent": "OPEN_FORM",
        "description": "新建竞争对手记录。点击新建按钮打开表单弹窗，填写并保存后创建记录。标准 API：POST /competitors，批量 API：POST /competitors/batch。"
      },
      {
        "code": "IMPORT",
        "name": "导入",
        "scope": "GLOBAL",
        "operationKind": "IMPORT",
        "primaryDataAction": "CREATE",
        "authzAction": "IMPORT",
        "httpMethod": "POST",
        "actionPath": "import",
        "async": false,
        "singleResultType": "ApiResponse<CompetitorImportResultDTO>",
        "position": "TOOLBAR",
        "triggerEvent": "OPEN_FORM",
        "description": "批量导入竞争对手数据，执行必填和枚举校验。API：POST /competitors/import。"
      },
      {
        "code": "DOWNLOAD_IMPORT_TEMPLATE",
        "name": "下载导入模板",
        "scope": "GLOBAL",
        "operationKind": "CUSTOM",
        "primaryDataAction": "READ",
        "authzAction": "READ",
        "httpMethod": "POST",
        "actionPath": "import-template",
        "supportsBatch": false,
        "singleResultType": "Void",
        "position": "TOOLBAR",
        "triggerEvent": "API_CALL",
        "description": "下载竞争对手数据导入 Excel 模板文件。API：POST /competitors/import-template。"
      },
      {
        "code": "EXPORT",
        "name": "导出",
        "scope": "GLOBAL",
        "operationKind": "EXPORT",
        "primaryDataAction": "READ",
        "authzAction": "EXPORT",
        "httpMethod": "POST",
        "actionPath": "export",
        "async": true,
        "singleResultType": "ApiResponse<ExportTaskDTO>",
        "position": "TOOLBAR",
        "triggerEvent": "API_CALL",
        "description": "导出竞争对手列表数据，敏感字段按权限脱敏或隐藏。API：POST /competitors/export。"
      },
      {
        "code": "EDIT",
        "name": "编辑竞争对手",
        "scope": "BO",
        "operationKind": "UPDATE",
        "primaryDataAction": "UPDATE",
        "authzAction": "UPDATE",
        "httpMethod": "PATCH",
        "supportsBatch": true,
        "singleResultType": "ApiResponse<CompetitorDTO>",
        "batchResultType": "BatchResultDTO",
        "position": "DETAIL",
        "triggerEvent": "OPEN_FORM",
        "description": "修改竞争对手信息、竞争力、分析文档和备注。标准 API：PATCH /competitors/{id}，批量 API：PATCH /competitors/batch。"
      },
      {
        "code": "DELETE",
        "name": "删除竞争对手",
        "scope": "BO",
        "operationKind": "DELETE",
        "primaryDataAction": "DELETE",
        "authzAction": "DELETE",
        "httpMethod": "DELETE",
        "supportsBatch": true,
        "singleResultType": "Void",
        "batchResultType": "BatchResultDTO",
        "position": "DETAIL",
        "triggerEvent": "CONFIRM_THEN_API",
        "description": "逻辑删除竞争对手记录（is_deleted=1）。标准 API：DELETE /competitors/{id}，批量 API：DELETE /competitors/batch。"
      },
      {
        "code": "ACTIVATE",
        "name": "启用竞争对手",
        "scope": "BO",
        "operationKind": "STATE_CHANGE",
        "primaryDataAction": "UPDATE",
        "authzAction": "ACTIVATE",
        "httpMethod": "POST",
        "actionPath": "activate",
        "supportsBatch": false,
        "singleResultType": "Void",
        "position": "DETAIL",
        "triggerEvent": "CONFIRM_THEN_API",
        "description": "将已停用的竞争对手重新启用，启用后可被场景引用。API：PUT /competitors/{id}/activate。"
      },
      {
        "code": "DEACTIVATE",
        "name": "停用竞争对手",
        "scope": "BO",
        "operationKind": "STATE_CHANGE",
        "primaryDataAction": "UPDATE",
        "authzAction": "DEACTIVATE",
        "httpMethod": "POST",
        "actionPath": "deactivate",
        "supportsBatch": false,
        "singleResultType": "Void",
        "position": "DETAIL",
        "triggerEvent": "CONFIRM_THEN_API",
        "description": "停用竞争对手，停用后不可被场景引用。API：PUT /competitors/{id}/deactivate。"
      }
    ]
  },
  "changeNote": [
    "competitors 首版 OPERATION 设计态 Fragment",
    "+ DOWNLOAD_IMPORT_TEMPLATE（下载导入模板，CUSTOM/READ，actionPath=import-template）"
  ]
}
