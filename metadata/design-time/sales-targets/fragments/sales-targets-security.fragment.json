{
  "$schema": "https://authz.xbac/schemas/gov/bo-meta-fragment.schema.json",
  "tenantId": "cbg",
  "appCode": "crm",
  "boCode": "sales-targets",
  "metaType": "SECURITY",
  "draftVersion": "1.0",
  "schemaVersion": "2.0",
  "content": {
    "rowSecurity": {
      "fallbackScope": "NONE",
      "entriesByEntity": {
        "target": [
          "tenant_code",
          "owner_type",
          "owner_id",
          "goal_type",
          "apply_rule",
          "target_year"
        ]
      }
    },
    "fieldSecurity": [
      {
        "entityCode": "target",
        "fieldCode": "goal_value",
        "fieldControl": "RESTRICTED",
        "privacyClass": "SENSITIVE",
        "reason": "目标值为敏感商业数据，需按行级数据策略控制可见范围"
      }
    ],
    "authzProjection": {
      "description": "销售目标业务对象在 PSP 中的资源属性投影。行级权限候选字段以目标方类型、目标对象、目标类型、适配规则、年份维度为主。",
      "usageNote": "用于数据权限、列表行级过滤和敏感字段访问控制。rowSecurity 声明 DATA 策略候选字段，fieldSecurity 声明 FIELD 策略候选字段（目标值 RESTRICTED）。策略表达式中典型引用方式包括 res.tenant_code、res.target_owner_type、res.target_id、res.target_type、res.apply_rule、res.target_year 等。",
      "attributes": [
        {
          "code": "target_record_id",
          "name": "目标记录主键",
          "type": "LONG",
          "source": {
            "entityCode": "target",
            "fieldCode": "id"
          },
          "isPk": true,
          "filterable": false,
          "nullable": false,
          "onMissingValue": "DENY",
          "displayOrder": 10,
          "displayGroup": "基本标识",
          "description": "目标记录资源唯一标识，供 PIP 按 ID 拉取完整属性集合。",
          "i18nKey": "auth.resource.res_sales_target.attr.target_record_id",
          "valueExamples": [
            "1",
            "100"
          ]
        },
        {
          "code": "tenant_code",
          "name": "租户编码",
          "type": "STRING",
          "source": {
            "entityCode": "target",
            "fieldCode": "tenant_code"
          },
          "filterable": true,
          "nullable": false,
          "onMissingValue": "DENY",
          "displayOrder": 20,
          "displayGroup": "数据范围",
          "description": "目标记录所属租户。典型表达式：sub.tenant_code == res.tenant_code。",
          "i18nKey": "auth.resource.res_sales_target.attr.tenant_code",
          "valueExamples": [
            "gov-default",
            "ent-default"
          ]
        },
        {
          "code": "target_owner_type",
          "name": "目标方类型",
          "type": "STRING",
          "source": {
            "entityCode": "target",
            "fieldCode": "owner_type"
          },
          "filterable": true,
          "nullable": false,
          "onMissingValue": "DENY",
          "allowedValues": [
            {
              "value": "EMPLOYEE",
              "label": "员工"
            },
            {
              "value": "CUSTOMER",
              "label": "客户"
            }
          ],
          "displayOrder": 30,
          "displayGroup": "资源属性",
          "description": "目标方类型。典型表达式：res.target_owner_type == 'EMPLOYEE'。",
          "i18nKey": "auth.resource.res_sales_target.attr.target_owner_type",
          "valueExamples": [
            "EMPLOYEE",
            "CUSTOMER"
          ]
        },
        {
          "code": "target_id",
          "name": "目标对象ID",
          "type": "STRING",
          "source": {
            "entityCode": "target",
            "fieldCode": "owner_id"
          },
          "filterable": true,
          "nullable": false,
          "onMissingValue": "DENY",
          "displayOrder": 40,
          "displayGroup": "资源属性",
          "description": "目标对象ID（员工ID或客户ID）。典型表达式：res.target_id == sub.user_id。",
          "i18nKey": "auth.resource.res_sales_target.attr.target_id",
          "valueExamples": [
            "1001",
            "2001"
          ]
        },
        {
          "code": "target_type",
          "name": "目标类型",
          "type": "STRING",
          "source": {
            "entityCode": "target",
            "fieldCode": "goal_type"
          },
          "filterable": true,
          "nullable": false,
          "onMissingValue": "DENY",
          "allowedValues": [
            {
              "value": "ORDER_AMOUNT",
              "label": "订单"
            },
            {
              "value": "INVOICE_AMOUNT",
              "label": "开票"
            },
            {
              "value": "GROSS_MARGIN_RATE",
              "label": "毛利率"
            },
            {
              "value": "VISIT_COUNT",
              "label": "拜访次数"
            },
            {
              "value": "SIGNED_CUSTOMER_COUNT",
              "label": "签约个数"
            },
            {
              "value": "LAST_YEAR_RENEWAL_FORECAST_AMOUNT",
              "label": "上一年续保预测金额"
            },
            {
              "value": "LAST_YEAR_RENEWAL_FORECAST_COUNT",
              "label": "上一年续保预测数量"
            },
            {
              "value": "CURRENT_YEAR_NEW_EXPIRING_FORECAST_AMOUNT",
              "label": "当年新增出保预测金额"
            },
            {
              "value": "CURRENT_YEAR_NEW_EXPIRING_FORECAST_COUNT",
              "label": "当年新增出保预测数量"
            }
          ],
          "displayOrder": 50,
          "displayGroup": "资源属性",
          "description": "目标类型。典型表达式：res.target_type == 'ORDER_AMOUNT'。",
          "i18nKey": "auth.resource.res_sales_target.attr.target_type",
          "valueExamples": [
            "ORDER_AMOUNT",
            "VISIT_COUNT"
          ]
        },
        {
          "code": "apply_rule",
          "name": "适配规则",
          "type": "STRING",
          "source": {
            "entityCode": "target",
            "fieldCode": "apply_rule"
          },
          "filterable": true,
          "nullable": false,
          "onMissingValue": "DENY",
          "allowedValues": [
            {
              "value": "YEARLY",
              "label": "年度"
            },
            {
              "value": "MONTHLY",
              "label": "月度"
            }
          ],
          "displayOrder": 60,
          "displayGroup": "资源属性",
          "description": "适配规则。典型表达式：res.apply_rule == 'YEARLY'。",
          "i18nKey": "auth.resource.res_sales_target.attr.apply_rule",
          "valueExamples": [
            "YEARLY",
            "MONTHLY"
          ]
        },
        {
          "code": "target_year",
          "name": "目标年份",
          "type": "INTEGER",
          "source": {
            "entityCode": "target",
            "fieldCode": "target_year"
          },
          "filterable": true,
          "nullable": false,
          "onMissingValue": "DENY",
          "displayOrder": 70,
          "displayGroup": "资源属性",
          "description": "目标年份。典型表达式：res.target_year == 2026。",
          "i18nKey": "auth.resource.res_sales_target.attr.target_year",
          "valueExamples": [
            "2025",
            "2026"
          ]
        }
      ]
    }
  }
}
