  "content": {
    "operations": [
      {
        "code": "CREATE",
        "name": "新建场景",
        "scope": "BO",
        "operationKind": "CREATE",
        "primaryDataAction": "CREATE",
        "authzAction": "CREATE",
        "httpMethod": "POST",
        "supportsBatch": true,
        "singleResultType": "SceneDTO",
        "batchResultType": "BatchResultDTO",
        "position": "TOOLBAR",
        "triggerEvent": "OPEN_FORM",
        "description": "从 CRM 场景列表页新建场景。打开新增弹窗和保存新增结果都使用 CREATE 权限；保存只是创建命令的提交阶段，不生成 SAVE 权限项。标准 API：POST /scenes，批量 API：POST /scenes/batch。"
      },
      {
        "code": "IMPORT",
        "name": "导入",
        "scope": "GLOBAL",
        "operationKind": "IMPORT",
        "primaryDataAction": "CREATE",
        "authzAction": "IMPORT",
        "httpMethod": "POST",
        "actionPath": "import",
        "async": false,
        "singleResultType": "SceneImportResultDTO",
        "position": "TOOLBAR",
        "triggerEvent": "OPEN_FORM",
        "description": "批量导入场景基础信息、产品清单、典配与年度测算，执行必填和枚举校验。API：POST /scenes/import。"
      },
      {
        "code": "EXPORT",
