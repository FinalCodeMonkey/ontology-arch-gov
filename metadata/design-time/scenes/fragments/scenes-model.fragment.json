  "content": {
    "boCode": "scenes",
    "boName": "场景",
    "description": "场景管理业务对象，采用主从明细聚合建模。",
    "apiConfig": {
      "resourcePath": "/scenes",
      "idField": "id",
      "idType": "LONG",
      "businessKeyField": "scene_no",
      "aggregateApiPolicy": {
        "listProjectionScope": "ROOT_SUMMARY",
        "readScope": "FULL_AGGREGATE",
        "createScope": "FULL_AGGREGATE",
        "updateScope": "ROOT_ENTITY_ONLY",
        "deleteScope": "CASCADE_AGGREGATE",
        "orphanPolicy": "DENY_DELETE_WHEN_CHILD_EXISTS",
        "detailEmbedEntities": [
          "scene-product",
          "scene-product-accessory",
          "scene-annual-estimate",
          "scene-rival-summary",
          "scene-rival-detail",
          "scene-team-member",
          "scene-product-team-member"
        ],
        "aggregateReplaceActionPath": "replace-aggregate",
        "alternateAggregateApis": [
          {
            "code": "GET_SCENE_ROOT",
            "name": "查询场景主实体",
            "method": "GET",
            "path": "/scenes/{id}/root",
            "requestScope": "NONE",
            "responseScope": "ROOT_ENTITY_ONLY",
            "resultType": "ApiResponse<SceneRootDTO>",
            "description": "只返回 scene_main 主实体字段，不内嵌产品清单、竞对和团队成员。"
          },
          {
            "code": "CREATE_SCENE_ROOT",
            "name": "创建场景主实体",
            "method": "POST",
            "path": "/scenes/root",
            "requestScope": "ROOT_ENTITY_ONLY",
            "responseScope": "ROOT_ENTITY_ONLY",
            "resultType": "ApiResponse<SceneRootDTO>",
            "description": "只创建 scene_main 主实体，产品清单、竞对和团队成员后续通过子实体接口维护。"
          },
          {
            "code": "PATCH_SCENE_AGGREGATE",
            "name": "增量更新完整场景聚合",
            "method": "PATCH",
            "path": "/scenes/{id}/aggregate",
            "requestScope": "FULL_AGGREGATE_PATCH",
            "responseScope": "FULL_AGGREGATE",
            "resultType": "ApiResponse<SceneDTO>",
            "description": "显式增量更新完整聚合，允许同时提交主实体和子实体变更。"
          },
          {
            "code": "REPLACE_SCENE_AGGREGATE",
            "name": "替换完整场景聚合",
            "method": "POST",
            "path": "/scenes/{id}/replace-aggregate",
            "requestScope": "FULL_AGGREGATE_REPLACE",
            "responseScope": "FULL_AGGREGATE",
            "resultType": "ApiResponse<SceneDTO>",
            "description": "显式替换完整聚合，整体替换主实体与子实体。"
          }
        ]
      },
      "searchEnabled": true,
      "batchEnabled": true
    },
    "boConfig": {
      "objectType": "MASTER_DETAIL",
      "nameField": "scene_name_customer",
      "statusField": "status",
      "logicDeleteFlag": true,
      "versionFlag": false,
      "idStrategy": "SNOWFLAKE",
      "auditStrategy": "APPLICATION",
      "defaultSort": {
        "field": "created_time",
        "direction": "desc"
      }
    },
