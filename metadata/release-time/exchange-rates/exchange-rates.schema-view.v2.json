  "rules": [
    {
      "code": "EXCHANGE_RATE_DATE_RANGE_VALID",
      "name": "生效日期必须早于失效日期",
      "ruleType": "COMPLEX_VALIDATION",
      "scope": "BO",
      "trigger": "BEFORE_VALIDATE",
      "severity": "ERROR",
      "message": "生效日期必须早于失效日期",
      "description": "汇率记录的 effective_date 必须严格早于 expiry_date。",
      "expression": "effective_date >= expiry_date",
      "exprAst": {
        "type": "binary",
        "op": "GTE",
