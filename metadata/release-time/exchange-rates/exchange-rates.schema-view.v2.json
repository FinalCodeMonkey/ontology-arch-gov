    "nameField": "rate_no",
    "statusField": "status",
    "logicDeleteFlag": true,
    "versionFlag": false,
    "idStrategy": "SNOWFLAKE",
    "auditStrategy": "APPLICATION",
    "defaultSort": {
      "field": "effective_date",
      "direction": "desc"
    }
  },
  "listViewConfig": {
    "defaultPageSize": 20,
    "formLayout": "GRID",
