          "fieldName": "company_scale",
          "columnName": "company_scale",
          "semanticRole": "NORMAL",
          "filterable": true,
          "validation": {
            "min": 0,
            "message": "规模必须为非负数"
          },
          "view": {
            "displayName": "规模(人)",
            "sortable": true,
            "columnWidth": 100,
            "order": 30,
            "showInList": true,
            "showInDetail": true,
            "editableInForm": true,
            "formType": "NUMBER",
            "placeholder": "请输入规模，例如5000",
            "queryable": true,
            "queryOperatorOptions": [
              {
                "value": "EQ",
                "label": "等于"
              }
            ],
            "dataType": "integer",
            "exportable": true,
            "importable": true
          }
        },
        {
          "code": "competition_level",
          "name": "竞争力",
          "type": "STRING",
          "isPk": false,
          "fieldName": "competition_level",
          "columnName": "competition_level",
          "semanticRole": "NORMAL",
          "filterable": true,
          "validation": {
            "required": true,
            "max": 50,
            "enum": [
              {
                "value": "STRONG",
                "label": "强竞争力"
              },
              {
                "value": "POTENTIAL",
                "label": "潜在竞争力"
              },
              {
                "value": "NORMAL",
                "label": "一般竞争力"
              },
              {
                "value": "WEAK",
                "label": "弱竞争力"
              }
            ],
            "message": "竞争力必须为预定义值之一"
          },
          "semanticMapping": {
            "targetOntology": "risk_level",
            "description": "竞争力等级 → 风险等级的语义映射，供推理引擎/本体评估器在计算 competitor_risk_level 时使用",
            "map": {
              "STRONG": "HIGH",
              "POTENTIAL": "MEDIUM",
              "NORMAL": "MEDIUM",
              "WEAK": "LOW"
            }
          },
          "view": {
            "displayName": "竞争力",
            "sortable": true,
            "columnWidth": 120,
            "order": 40,
            "showInList": true,
            "showInDetail": true,
            "editableInForm": true,
            "formType": "SELECT",
            "placeholder": "请选择竞争力",
            "queryable": true,
            "queryOperatorOptions": [
              {
                "value": "EQ",
                "label": "等于"
              }
            ],
            "dataType": "string",
            "exportable": true,
            "importable": true,
            "dictCode": "competitor_competition_level"
          }
        },
