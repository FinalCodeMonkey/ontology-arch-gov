{
  "$schema": "https://authz.xbac/schemas/gov/bo-schema-view.v2.schema.json",
  "boCode": "competitors",
  "boName": "竞争对手",
  "description": "竞争对手主数据业务对象，单表建模，记录竞争对手基本画像、竞争分析、应对策略及分析文档。",
  "schemaVersion": "2.0",
