    "resourcePath": "/competitors",
    "idField": "id",
    "idType": "LONG",
    "responseWrapper": "ApiResponse",
    "batchResultType": "BatchResultDTO",
    "businessKeyField": "competitor_name",
    "aggregateApiPolicy": {
      "listProjectionScope": "ROOT_SUMMARY",
      "readScope": "FULL_AGGREGATE",
      "createScope": "FULL_AGGREGATE",
      "updateScope": "ROOT_ENTITY_ONLY",
      "deleteScope": "ROOT_ENTITY_ONLY",
      "orphanPolicy": "DENY_DELETE_WHEN_CHILD_EXISTS",
      "detailEmbedEntities": []
    },
    "searchEnabled": true,
    "batchEnabled": true
  },
  "boConfig": {
    "objectType": "SINGLE",
    "nameField": "competitor_name",
    "statusField": "status",
    "logicDeleteFlag": true,
    "versionFlag": false,
    "defaultSort": {
      "field": "created_time",
      "direction": "desc"
    }
  },
  "listViewConfig": {
    "defaultPageSize": 20,
    "formLayout": "GRID",
    "formColumns": 2,
    "formLabelWidth": 140,
    "searchCollapsible": true
  },
  "entities": [
