            "formType": "INPUT",
            "placeholder": "请输入竞争对手名称",
            "queryable": true,
            "queryOperatorOptions": [
              {
                "value": "LIKE",
                "label": "包含"
              }
            ],
            "dataType": "string",
            "exportable": true,
            "importable": true
          }
        },
        {
          "code": "company_scale",
          "name": "规模(人)",
