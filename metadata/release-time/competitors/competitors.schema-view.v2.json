          "code": "id",
          "name": "竞争对手ID",
          "type": "LONG",
          "isPk": true,
          "fieldName": "id",
          "columnName": "id",
          "semanticRole": "TECHNICAL_ID",
          "filterable": false,
          "validation": {
            "required": true
          },
          "view": {
            "displayName": "编号",
            "sortable": false,
            "columnWidth": 70,
            "order": 10,
            "showInList": false,
            "showInDetail": true,
            "editableInForm": false,
            "formType": "HIDDEN",
            "dataType": "integer",
            "exportable": false,
            "importable": false
          }
        },
        {
          "code": "competitor_name",
          "name": "竞争对手名称",
          "type": "STRING",
          "isPk": false,
          "fieldName": "competitor_name",
          "columnName": "competitor_name",
          "semanticRole": "NAME",
          "filterable": true,
          "validation": {
            "required": true,
            "max": 200,
            "unique": true,
            "message": "竞争对手名称不能为空且不超过200字"
          },
          "view": {
            "displayName": "竞争对手名称",
            "sortable": true,
            "columnWidth": 140,
            "order": 20,
            "showInList": true,
            "showInDetail": true,
            "editableInForm": true,
