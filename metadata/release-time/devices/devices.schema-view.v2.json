{
  "$schema": "https://authz.xbac/schemas/gov/bo-schema-view.v2.schema.json",
  "boCode": "devices",
  "boName": "设备档案",
  "description": "设备档案业务对象，管理已销售给客户的产品设备，以设备序列号（device_serial_no）作为业务主键。采用'外部聚合+本地覆盖'混合数据架构：设备主档信息（订单、客户、产品、保修、价格等）来自外部 DPR 系统只读聚合，本地 crm_device_local_state 表仅承载需服务销售侧维护覆盖的状态字段（device_status、product_status）。",
  "schemaVersion": "2.0",
  "apiConfig": {
    "resourcePath": "/devices",
    "idField": "id",
    "idType": "LONG",
    "responseWrapper": "ApiResponse",
    "batchResultType": "BatchResultDTO",
    "businessKeyField": "device_serial_no",
    "aggregateApiPolicy": {
      "listProjectionScope": "ROOT_SUMMARY",
      "readScope": "ROOT_ENTITY_ONLY",
      "createScope": "ROOT_ENTITY_ONLY",
      "updateScope": "ROOT_ENTITY_ONLY",
      "deleteScope": "ROOT_ENTITY_ONLY",
      "orphanPolicy": "DENY_DELETE_WHEN_CHILD_EXISTS",
      "detailEmbedEntities": []
    },
    "searchEnabled": true,
    "batchEnabled": true
  },
  "boConfig": {
    "objectType": "SINGLE",
    "nameField": "device_serial_no",
    "statusField": "device_status",
    "logicDeleteFlag": true,
    "versionFlag": false,
    "idStrategy": "SNOWFLAKE",
    "auditStrategy": "DATABASE",
    "defaultSort": {
      "field": "updated_time",
      "direction": "desc"
    }
  },
  "listViewConfig": {
    "defaultPageSize": 50,
    "formLayout": "GRID",
    "formColumns": 2,
    "formLabelWidth": 140,
    "searchCollapsible": true
  },
