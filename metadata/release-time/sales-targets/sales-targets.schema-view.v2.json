  "rules": [
    {
      "code": "TARGET_COMPOSITE_UNIQUE",
      "name": "目标复合唯一键",
      "ruleType": "COMPLEX_VALIDATION",
      "scope": "BO",
      "trigger": "BEFORE_VALIDATE",
      "severity": "ERROR",
      "message": "同一目标方、目标对象、目标类型、适配规则、年份/月份的目标记录已存在",
      "description": "创建或修改目标记录时，复合键 (owner_type, owner_id, goal_type, apply_rule, target_year, target_month) 在同一租户下必须唯一（含已逻辑删除记录）。对应数据库唯一索引 uk_target_unique。"
    },
    {
      "code": "MONTHLY_RULE_REQUIRES_MONTH",
      "name": "月度规则必须填写月份",
      "ruleType": "COMPLEX_VALIDATION",
      "scope": "ENTITY",
      "trigger": "BEFORE_VALIDATE",
      "severity": "ERROR",
      "message": "适配规则为月度时，目标月份不能为空",
      "description": "当 apply_rule=MONTHLY 时，target_month 必须填写（1-12）；当 apply_rule=YEARLY 时，target_month 应留空。",
      "entityCode": "target",
      "expression": "apply_rule == 'MONTHLY' && target_month == null",
      "exprAst": {
        "type": "logical",
        "op": "AND",
        "items": [
          {
            "type": "binary",
            "op": "EQ",
            "left": {
              "type": "field",
              "path": "apply_rule"
            },
            "right": {
              "type": "literal",
              "value": "MONTHLY"
            }
          },
          {
            "type": "isNull",
            "expr": {
              "type": "field",
              "path": "target_month"
            }
          }
        ]
      }
    },
    {
      "code": "YEARLY_RULE_NO_MONTH",
      "name": "年度规则不应填写月份",
      "ruleType": "COMPLEX_VALIDATION",
      "scope": "ENTITY",
      "trigger": "BEFORE_VALIDATE",
      "severity": "WARN",
      "message": "适配规则为年度时，目标月份应留空",
      "description": "当 apply_rule=YEARLY 时，target_month 应留空。若填写了月份，给出警告提示但不阻断保存。",
      "entityCode": "target",
      "expression": "apply_rule == 'YEARLY' && target_month != null",
      "exprAst": {
        "type": "logical",
        "op": "AND",
        "items": [
          {
            "type": "binary",
            "op": "EQ",
            "left": {
              "type": "field",
              "path": "apply_rule"
            },
            "right": {
              "type": "literal",
              "value": "YEARLY"
            }
          },
          {
            "type": "isNotNull",
            "expr": {
              "type": "field",
              "path": "target_month"
            }
          }
        ]
      }
    },
    {
