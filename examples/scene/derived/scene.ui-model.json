    { "code": "EDIT_TEAM_MEMBER", "position": "DETAIL", "triggerEvent": "OPEN_FORM" },
    { "code": "DELETE_TEAM_MEMBER", "position": "DETAIL", "triggerEvent": "CONFIRM_THEN_API" }
  ]
