      { "fieldCode": "scene_name_dept", "queryType": "LIKE", "formType": "INPUT" },
      { "fieldCode": "scene_name_customer", "queryType": "LIKE", "formType": "INPUT" },
      { "fieldCode": "business_name", "queryType": "EQ", "formType": "SELECT", "dictCode": "scene_business_name" },
