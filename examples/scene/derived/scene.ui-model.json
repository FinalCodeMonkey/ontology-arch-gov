      { "fieldCode": "lifecycle_end_date", "queryType": "BETWEEN", "formType": "DATE" },
      { "fieldCode": "future_procurement_amount", "queryType": "BETWEEN", "formType": "NUMBER" },
      { "fieldCode": "current_year_procurement_amount", "queryType": "BETWEEN", "formType": "NUMBER" },
      { "fieldCode": "current_year_estimated_sales", "queryType": "BETWEEN", "formType": "NUMBER" },
      { "fieldCode": "next_bid_date", "queryType": "BETWEEN", "formType": "DATE" },
      { "fieldCode": "our_stage", "queryType": "EQ", "formType": "SELECT", "dictCode": "scene_our_stage" },
      { "fieldCode": "status", "queryType": "EQ", "formType": "SELECT", "dictCode": "scene_status" }
