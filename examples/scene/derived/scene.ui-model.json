    { "code": "MANAGE_ACCESSORY", "position": "DETAIL", "triggerEvent": "OPEN_FORM" },
    { "code": "MANAGE_ANNUAL_ESTIMATE", "position": "DETAIL", "triggerEvent": "OPEN_FORM" },
    { "code": "ADJUST_RIVAL", "position": "DETAIL", "triggerEvent": "OPEN_FORM" },
    { "code": "CREATE_TEAM_MEMBER", "position": "DETAIL", "triggerEvent": "OPEN_FORM" },
