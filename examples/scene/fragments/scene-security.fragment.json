{
  "$schema": "https://authz.xbac/schemas/gov/bo-meta-fragment.schema.json",
  "tenantId": "default",
  "appCode": "government",
  "boCode": "SCENE",
  "metaType": "SECURITY",
  "draftVersion": 1,
  "schemaVersion": "2.0",
  "content": {
    "rowSecurity": {
      "fallbackScope": "NONE",
      "entriesByEntity": {
        "scene_main": [
          "fop_customer_id",
          "business_name",
          "scene_category",
          "sales_owner_id",
          "dept_id",
          "status"
        ]
      }
    },
    "fieldSecurity": [
      {
        "entityCode": "scene_main",
        "fieldCode": "sales_owner_id",
        "fieldControl": "RESTRICTED",
        "privacyClass": "SENSITIVE"
      },
      {
        "entityCode": "scene_main",
        "fieldCode": "future_procurement_amount",
        "fieldControl": "OPEN",
        "privacyClass": "SENSITIVE"
      },
      {
        "entityCode": "scene_main",
        "fieldCode": "current_year_procurement_amount",
        "fieldControl": "OPEN",
        "privacyClass": "SENSITIVE"
      },
      {
        "entityCode": "scene_main",
        "fieldCode": "current_year_estimated_sales",
        "fieldControl": "MASKED",
        "privacyClass": "SENSITIVE"
      },
      {
        "entityCode": "scene_product",
        "fieldCode": "future_procurement_amount",
        "fieldControl": "OPEN",
        "privacyClass": "SENSITIVE"
      },
      {
        "entityCode": "scene_product",
        "fieldCode": "current_year_procurement_amount",
        "fieldControl": "OPEN",
        "privacyClass": "SENSITIVE"
      },
      {
        "entityCode": "scene_product",
        "fieldCode": "current_year_estimated_sales",
        "fieldControl": "MASKED",
        "privacyClass": "SENSITIVE"
      },
      {
        "entityCode": "scene_annual_estimate",
        "fieldCode": "customer_procurement_amount",
        "fieldControl": "MASKED",
        "privacyClass": "SENSITIVE"
      },
      {
        "entityCode": "scene_annual_estimate",
        "fieldCode": "estimated_sales_amount",
        "fieldControl": "MASKED",
        "privacyClass": "SENSITIVE"
      },
      {
        "entityCode": "scene_rival_summary",
        "fieldCode": "ruijie_estimated_sales",
        "fieldControl": "MASKED",
        "privacyClass": "SENSITIVE"
      }
    ],
    "authzProjection": {
      "modelCode": "RES_SCENE",
      "modelName": "场景资源模型",
      "category": "RESOURCE",
      "description": "场景业务对象在 PSP 中的资源属性投影。RES_SCENE 用于标识 authz_bo_meta_model 中 SCENE 这条 BO 元数据的 res.* 属性视图，不是 PSP 标准资源模型枚举；运行时权限项仍通过 RES_DATA_BO + authz_bo_meta_model.id + act_code 定位 SCENE BO。",
      "usageNote": "用于数据权限、列表行级过滤和敏感字段访问控制。rowSecurity 声明 DATA 策略候选字段，fieldSecurity 声明 FIELD 策略候选字段，authzProjection 随 SCENE 的 authz_bo_meta_model.schema_json 发布，声明 PIP 可返回的 res.* 属性契约。策略表达式中典型引用方式包括 res.fop_customer_id、res.business_name、res.scene_category、res.sales_owner_id、res.dept_id、res.status、res.our_stage 等。字段控制发布到 PSP 时需将 MASKED/HIDDEN 转换为 MASK/HIDE。",
      "attributes": [
        {
          "code": "scene_id",
          "name": "场景ID",
          "type": "LONG",
          "source": { "entityCode": "scene_main", "fieldCode": "id" },
          "isPk": true,
          "filterable": false,
          "nullable": false,
          "onMissingValue": "DENY",
          "displayOrder": 10,
          "displayGroup": "基本标识",
          "description": "场景资源唯一标识，供 PIP 按 ID 拉取完整属性集合；不暴露给 ABAC 表达式做条件判断。",
          "i18nKey": "auth.resource.res_scene.attr.scene_id",
          "valueExamples": ["10001", "10002"]
        },
        {
          "code": "scene_name_dept",
          "name": "场景名称-部门标准",
          "type": "STRING",
          "source": { "entityCode": "scene_main", "fieldCode": "scene_name_dept" },
          "filterable": false,
          "nullable": false,
          "onMissingValue": "DENY",
          "displayOrder": 20,
          "displayGroup": "基本标识",
          "description": "部门内部使用的场景名称，主要用于展示和审计，不建议作为权限判断条件。",
          "i18nKey": "auth.resource.res_scene.attr.scene_name_dept",
          "valueExamples": ["阿里巴巴园区DCN3.0项目"]
        },
        {
          "code": "scene_name_customer",
          "name": "场景名称-客户标准",
          "type": "STRING",
          "source": { "entityCode": "scene_main", "fieldCode": "scene_name_customer" },
          "filterable": false,
          "nullable": false,
          "onMissingValue": "DENY",
          "displayOrder": 30,
          "displayGroup": "基本标识",
          "description": "面向客户侧表达的场景名称，主要用于展示和审计，不建议作为权限判断条件。",
          "i18nKey": "auth.resource.res_scene.attr.scene_name_customer",
          "valueExamples": ["园区DCN3.0"]
        },
        {
          "code": "fop_customer_id",
          "name": "FOP客户ID",
          "type": "STRING",
          "source": { "entityCode": "scene_main", "fieldCode": "fop_customer_id" },
          "filterable": true,
          "nullable": false,
          "onMissingValue": "DENY",
          "valueRef": "CUSTOMER.id",
          "referenceModel": "CUSTOMER",
          "displayOrder": 40,
          "displayGroup": "数据范围",
          "description": "场景归属的 FOP 客户。典型表达式：contains(sub.customer_scope_ids, res.fop_customer_id)。",
          "i18nKey": "auth.resource.res_scene.attr.fop_customer_id",
          "valueExamples": ["CUST-10001", "CUST-10002"]
        },
        {
          "code": "business_name",
          "name": "业务名称",
          "type": "STRING",
          "source": { "entityCode": "scene_main", "fieldCode": "business_name" },
          "filterable": true,
          "nullable": false,
          "onMissingValue": "DENY",
          "allowedValues": ["JDM业务", "DCN网络", "智算网络", "ESUN业务", "光", "园区网络"],
          "displayOrder": 50,
          "displayGroup": "资源属性",
          "description": "场景所属业务线。典型表达式：contains(sub.business_scope, res.business_name)。",
          "i18nKey": "auth.resource.res_scene.attr.business_name",
          "valueExamples": ["园区网络", "JDM业务"]
        },
        {
          "code": "scene_category",
          "name": "场景分类",
          "type": "STRING",
          "source": { "entityCode": "scene_main", "fieldCode": "scene_category" },
          "filterable": true,
          "nullable": false,
          "onMissingValue": "DENY",
          "allowedValues": ["H1", "H2", "H3"],
          "displayOrder": 60,
          "displayGroup": "资源属性",
          "description": "场景分层分类。典型表达式：res.scene_category == 'H1'。",
          "i18nKey": "auth.resource.res_scene.attr.scene_category",
          "valueExamples": ["H1", "H2"]
        },
        {
          "code": "sales_owner_id",
          "name": "销售负责人ID",
          "type": "STRING",
          "source": { "entityCode": "scene_main", "fieldCode": "sales_owner_id" },
          "filterable": true,
          "nullable": false,
          "onMissingValue": "DENY",
          "valueRef": "SUB_USER.id",
          "referenceModel": "SUB_USER",
          "displayOrder": 70,
          "displayGroup": "数据范围",
          "description": "场景销售负责人。典型表达式：sub.user_id == res.sales_owner_id。",
          "i18nKey": "auth.resource.res_scene.attr.sales_owner_id",
          "valueExamples": ["U10001"]
        },
        {
          "code": "dept_id",
          "name": "所属部门ID",
          "type": "STRING",
          "source": { "entityCode": "scene_main", "fieldCode": "dept_id" },
          "filterable": true,
          "nullable": false,
          "onMissingValue": "DENY",
          "valueRef": "SUB_ORG.id",
          "referenceModel": "SUB_ORG",
          "displayOrder": 80,
          "displayGroup": "数据范围",
          "description": "场景所属部门。典型表达式：contains(sub.dept_scope_ids, res.dept_id)。",
          "i18nKey": "auth.resource.res_scene.attr.dept_id",
          "valueExamples": ["D10001"]
        },
        {
          "code": "our_stage",
          "name": "我司阶段",
          "type": "STRING",
          "source": {
            "entityCode": "scene_product",
            "fieldCode": "our_stage",
            "computed": true,
            "derivationHint": "从场景产品清单聚合汇总当前我司阶段，写回 scene_main.our_stage 或由 PIP 查询时计算。"
          },
          "filterable": true,
          "nullable": true,
          "onMissingValue": "ALLOW",
          "allowedValues": ["0-未开始", "1-建立连接", "2-技术交流", "3-产品开发", "4-获得入围机会", "5-完成入围测试", "6-进入产品清单"],
          "displayOrder": 90,
          "displayGroup": "资源属性",
          "description": "场景产品清单汇总后的当前我司阶段，可用于限制特定阶段的数据操作。",
          "i18nKey": "auth.resource.res_scene.attr.our_stage",
          "valueExamples": ["2-技术交流", "3-产品开发"]
        },
        {
          "code": "lifecycle_end_date",
          "name": "预计生命周期结束时间",
          "type": "DATE",
          "source": {
            "entityCode": "scene_product",
            "fieldCode": "lifecycle_end_date",
            "computed": true,
            "derivationHint": "从产品清单生命周期结束时间汇总出场景级生命周期结束时间。"
          },
          "filterable": true,
          "nullable": true,
          "onMissingValue": "ALLOW",
          "displayOrder": 100,
          "displayGroup": "时间约束",
          "description": "场景产品生命周期结束时间，可用于过期场景只读或归档策略。",
          "i18nKey": "auth.resource.res_scene.attr.lifecycle_end_date",
          "valueExamples": ["2030-12-31"]
        },
        {
          "code": "next_bid_date",
          "name": "下次招标时间",
          "type": "DATE",
          "source": {
            "entityCode": "scene_product",
            "fieldCode": "next_bid_date",
            "computed": true,
            "derivationHint": "从产品清单下次招标时间汇总出场景级下次招标时间。"
          },
          "filterable": true,
          "nullable": true,
          "onMissingValue": "ALLOW",
          "displayOrder": 110,
          "displayGroup": "时间约束",
          "description": "场景下次招标时间，可用于临近招标窗口的数据保护或提醒策略。",
          "i18nKey": "auth.resource.res_scene.attr.next_bid_date",
          "valueExamples": ["2026-04-10"]
        },
        {
          "code": "current_year_estimated_sales",
          "name": "本年度预计销量",
          "type": "DECIMAL",
          "source": {
            "entityCode": "scene_product",
            "fieldCode": "current_year_estimated_sales",
            "computed": true,
            "derivationHint": "从产品清单或年度测算汇总出场景级本年度预计销量。"
          },
          "filterable": true,
          "nullable": true,
          "onMissingValue": "ALLOW",
          "displayOrder": 120,
          "displayGroup": "敏感经营数据",
          "description": "本年度预计销量，属于敏感经营数据，可用于较高金额场景的审批或脱敏策略。",
          "i18nKey": "auth.resource.res_scene.attr.current_year_estimated_sales",
          "valueExamples": ["11761200.00"]
        },
        {
          "code": "status",
          "name": "场景状态",
          "type": "STRING",
          "source": { "entityCode": "scene_main", "fieldCode": "status" },
          "filterable": true,
          "nullable": false,
          "onMissingValue": "DENY",
          "allowedValues": ["DRAFT", "ACTIVE", "ARCHIVED"],
          "displayOrder": 130,
          "displayGroup": "资源属性",
          "description": "场景状态。典型表达式：res.status == 'ACTIVE'。",
          "i18nKey": "auth.resource.res_scene.attr.status",
          "valueExamples": ["ACTIVE"]
        }
      ]
    }
  },
  "changeNote": "SCENE 首版 SECURITY 设计态 Fragment。"
}
