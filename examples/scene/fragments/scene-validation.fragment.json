{
    "$schema":  "https://authz.xbac/schemas/gov/bo-meta-fragment.schema.json",
    "tenantId":  "default",
    "appCode":  "government",
    "boCode":  "SCENE",
    "metaType":  "VALIDATION",
    "draftVersion":  1,
