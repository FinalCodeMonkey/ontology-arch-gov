{
  "$schema": "https://authz.xbac/schemas/gov/bo-meta-fragment.schema.json",
  "tenantId": "default",
  "appCode": "government",
  "boCode": "SCENE",
  "metaType": "OPERATION",
  "draftVersion": 1,
  "schemaVersion": "2.0",
  "content": {
    "operations": [
      {
        "code": "CREATE",
        "name": "新建场景",
        "scope": "BO",
        "operationKind": "CREATE",
        "authzAction": "CREATE",
        "httpMethod": "POST",
        "supportsBatch": true,
        "singleResultType": "SceneDTO",
        "batchResultType": "BatchResultDTO",
        "position": "TOOLBAR",
        "triggerEvent": "OPEN_FORM",
        "prototypeRefs": [
          {
            "file": "government/场景管理/场景列表.html",
            "label": "+ 新建场景",
            "event": "openSceneDialog()",
            "positionHint": "列表页工具栏"
          },
          {
            "file": "government/场景管理/场景列表.html",
            "label": "创建场景",
            "event": "closeSceneDialog();alert('场景已创建')",
            "positionHint": "新建场景弹窗底部"
          }
        ],
        "description": "从 CRM 场景列表页新建场景。打开新增弹窗和保存新增结果都使用 CREATE 权限；保存只是创建命令的提交阶段，不生成 SAVE 权限项。标准 API：POST /scenes，批量 API：POST /scenes/batch。"
      },
      {
        "code": "IMPORT",
        "name": "导入",
        "scope": "GLOBAL",
        "operationKind": "IMPORT",
        "authzAction": "IMPORT",
        "httpMethod": "POST",
        "actionPath": "import",
        "async": false,
        "singleResultType": "SceneImportResultDTO",
        "position": "TOOLBAR",
        "triggerEvent": "OPEN_FORM",
        "prototypeRefs": [
          {
            "file": "government/场景管理/场景列表.html",
            "label": "导入",
            "positionHint": "列表页工具栏"
          }
        ],
        "description": "批量导入场景基础信息、产品清单、典配与年度测算，执行必填和枚举校验。API：POST /scenes/import。"
      },
      {
        "code": "EXPORT",
        "name": "导出",
        "scope": "GLOBAL",
        "operationKind": "EXPORT",
        "authzAction": "EXPORT",
        "httpMethod": "POST",
        "actionPath": "export",
        "async": true,
        "singleResultType": "ExportTaskDTO",
        "position": "TOOLBAR",
        "triggerEvent": "API_CALL",
        "prototypeRefs": [
          {
            "file": "government/场景管理/场景列表.html",
            "label": "导出",
            "positionHint": "列表页工具栏"
          }
        ],
        "description": "导出场景列表数据，金额和销量字段按权限脱敏。API：POST /scenes/export。"
      },
      {
        "code": "EDIT_SCENE",
