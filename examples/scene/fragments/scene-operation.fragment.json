        "scope": "BO",
        "operationKind": "UPDATE",
        "authzAction": "UPDATE",
        "httpMethod": "PATCH",
        "supportsBatch": true,
        "singleResultType": "SceneDTO",
        "batchResultType": "BatchResultDTO",
        "position": "DETAIL",
        "triggerEvent": "OPEN_FORM",
        "prototypeRefs": [
          {
            "file": "government/场景管理/场景详情.html",
            "label": "编辑",
            "event": "openEditDialog()",
            "positionHint": "详情页头部"
          },
          {
            "file": "government/场景管理/场景详情.html",
            "label": "保存修改",
            "event": "closeEditDialog();alert('修改已保存')",
            "positionHint": "编辑场景弹窗底部"
          }
        ],
        "description": "修改场景基础信息、业务名称、分类、销售负责人和场景说明。点击编辑、进入编辑态、保存编辑结果都使用 UPDATE 权限；保存只是编辑命令的提交阶段，不生成 SAVE 权限项。标准 API：PATCH /scenes/{id}，批量 API：PATCH /scenes/batch。"
      },
